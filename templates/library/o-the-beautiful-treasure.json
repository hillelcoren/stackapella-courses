{
 "id": "o-the-beautiful-treasure",
 "version": 1,
 "reviewed": true,
 "title": "O the Beautiful Treasure",
 "description": "A Shaker song headed \"Valuable Riches\" in Mary Hazzard's songbook (about 1849), signed \"Holy Ground\", for 2 to 4 singers: the beautiful treasure laid up for the wise, far brighter than diamonds. The soprano sings the minor-key tune, the alto and tenor sing the words close beneath it, and the bass holds the roots on \"oo\"; each strain is sung twice, as the book marks it.",
 "difficulty": "beginner",
 "genre": [
  "shaker",
  "folk",
  "sacred"
 ],
 "style": "straight",
 "tempo": 100,
 "key": "Em",
 "timeSignature": "4/4",
 "pickupBeats": 2,
 "language": "en",
 "credits": {
  "words": "Shaker song (Mary Hazzard's songbook, about 1849)",
  "tune": "Shaker song (Mary Hazzard's songbook, about 1849)",
  "arrangement": "Stackapella"
 },
 "licence": {
  "words": "public domain: a Shaker song with no maker named, copied about 1849 into Mary Hazzard's manuscript songbook (begun 1847)",
  "tune": "public domain: a Shaker song with no maker named, copied about 1849 into Mary Hazzard's manuscript songbook (begun 1847)",
  "arrangement": "original, written for Stackapella",
  "recordings": "synthesized guides",
  "source": "melody and words from Mary Hazzard's manuscript book \"A Collection of Extra Songs of Various Kinds Written and Pricked For the Purpose of Retaining them\" (begun February 7th 1847), Winterthur Library, ASC 893, catalogue https://winterthur.libraryhost.com/repositories/2/archival_objects/95, page image 90 (the manuscript's page 70), headed \"Valuable Riches\", signed \"Holy Ground\" with no giver or date (two pages on, the manuscript's page 72 has \"Elder Joseph Brackett's Song March 1849\"); in Shaker letteral notation in A minor in 2/4 (head frame \"3\" with the crossed double bar), sung here a fourth lower, in E minor, in 4/4 with every value doubled; every pitch as written, \"wise\" on the B a third under the soprano's range, and the second strain's last two notes, \"be-stow\", read as the upper G and A because the scribe writes them above the strain's E; both strains sung twice, as the repeat signs mark them; breaths written in for beginners: \"wise,\" \"prize,\" \"brow,\" and \"stow,\" before each repeat give up their second beat; spelling modernised: \"Princes brow\" written \"Princes' brow\"; \"glorious\" sung in two syllables, as the notes give it; read from the scan of the whole book saved by Hillel from the Winterthur Library. Courtesy Winterthur Museum, Garden & Library.",
  "checked": null
 },
