{
 "id": "drunken-sailor",
 "version": 1,
 "reviewed": true,
 "title": "Drunken Sailor",
 "description": "The shanty everyone knows, for 2 to 4 singers, as R. R. Terry printed it in 1921: the soprano is the shantyman and sings the verse alone, then everyone comes in on the chorus, \"Hooray and up she rises\", in strong, simple chords on Terry's own harmony. An old Dorian tune, sung quick on the ships; take it steady to learn it.",
 "language": "en",
 "difficulty": "beginner",
 "genre": [
  "sea shanty",
  "folk",
  "traditional"
 ],
 "style": "free",
 "tempo": 88,
 "key": "Em",
 "timeSignature": "4/4",
 "pickupBeats": 0,
 "credits": {
  "words": "traditional sea shanty (as printed by R. R. Terry, 1921)",
  "tune": "traditional sea shanty (as printed by R. R. Terry, 1921)",
  "arrangement": "Stackapella"
 },
 "licence": {
  "words": "public domain: traditional, verse 1 and the chorus as printed by R. R. Terry, The Shanty Book, Part I (1921), No. 14, except \"What shall we do with a drunken sailor\" where Terry prints \"with the\": \"with a\" is printed by W. B. Whall, Ships, Sea Songs and Shanties (3rd ed., 1913), p. 107, and Cecil J. Sharp, English Folk-Chanteys (1914), No. VII",
  "tune": "public domain: traditional, printed 1921 by Richard Runciman Terry (died 1938)",
  "arrangement": "original, written for Stackapella on the harmony of Terry's piano accompaniment (public domain: Terry died 1938): the soprano is his voice part note for note; the alto, tenor and bass sing the chorus only, one note a syllable, on the notes of his accompaniment (all but two of their 81 notes are his, some an octave away), a whole tone higher; breaths written in for beginners",
  "recordings": "synthesized guides",
  "checked": null,
  "source": "tune, words and harmony from Richard Runciman Terry, The Shanty Book, Part I: Sailor Shanties (London: J. Curwen & Sons, 1921), No. 14, \"What shall we do with the drunken sailor?\" (Windlass and Capstan), pp. 30 and 31, the voice part and the piano accompaniment; printed in 2/4 with no key signature (D, Dorian), crotchet = 108, and written here a whole tone higher, in E, in 4/4 with a printed quaver as a beat; verse 1 and the chorus; read from the University of Toronto Faculty of Music Library copy at archive.org/details/shantybooksailor00terr (scan pages n51 and n52). Checked against W. B. Whall, Ships, Sea Songs and Shanties (3rd ed., Glasgow: James Brown & Son, 1913), \"Early in the Morning\", p. 107, archive.org/details/shipsseasongssha00whal (scan page n126)"
 },
