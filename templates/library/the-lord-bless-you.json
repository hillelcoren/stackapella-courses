{
 "id": "the-lord-bless-you",
 "version": 1,
 "reviewed": false,
 "title": "The Lord Bless You and Keep You",
 "description": "Peter Lutkin's choral blessing of 1900, for 4 singers, in his own four parts: the words from Numbers, slow and smooth, then his sevenfold Amen, where the voices come in one by one and build to a loud peak before a soft last chord.",
 "language": "en",
 "difficulty": "intermediate",
 "genre": [
  "classical",
  "sacred",
  "choral"
 ],
 "style": "straight",
 "tempo": 60,
