 "timeSignature": "4/4",
 "pickupBeats": 1,
 "credits": {
  "words": "Numbers 6:24 to 26 (King James Version), as Lutkin set them",
  "tune": "Peter C. Lutkin (1900)",
  "arrangement": "Lutkin's four parts (1900), adapted by Stackapella"
 },
 "licence": {
  "words": "public domain: the King James Version (1611), in Lutkin's wording (you for thee); in the UK the KJV is under Crown letters patent (a question with our lawyer)",
  "tune": "public domain: published 1900; Lutkin died 1931",
  "arrangement": "Peter C. Lutkin's own four voice parts as Clayton F. Summy published them in 1900 (public domain: Lutkin died 1931), sung a cappella without the optional organ, every pitch as printed, with breaths written in for beginners (four short notes left out to make room for them: the 8th notes on \"the\" in the alto and tenor in bar 6, and two slurred bass notes in bars 5 and 6), and the final fermata sung three beats",
  "recordings": "synthesized guides",
  "checked": null,
  "source": "Peter C. Lutkin, The Lord Bless You and Keep You: Farewell Anthem with Sevenfold Amen, for mixed voices, organ ad lib. (Chicago: Clayton F. Summy Co., 1900; plate C.F.S. Co. 524-3), in C, pp. 2 to 4, read from a later Summy printing of the 1900 plates (cover catalogue no. 1089; \"Copyright 1900 by Clayton F. Summy Co., renewed 1928 by Peter C. Lutkin\") scanned at archive.org/details/TheLordBlessYouAndKeepYou_700 (Folkscanomy collection, 2012; the same scan is IMSLP #525534); the blessing (bars 1 to 14) checked note for note against The Methodist Hymnal (New York: Eaton and Mains; Cincinnati: Jennings and Graham, 1905), No. 748, p. 532, edited by Lutkin, which prints the same four parts with a plain two-chord Amen in place of the sevenfold one, Princeton Theological Seminary Library's copy at archive.org/details/methodi00meth (scan page n543)"
 },
