{
 "id": "haul-away-joe",
 "version": 1,
 "reviewed": false,
 "title": "Haul Away, Joe",
 "description": "A pulling shanty for 2 to 4 singers: the soprano is the shantyman and sings each call alone, and everyone answers \"Way, haul away, haul away, Joe\" in harmony, landing together on \"Joe\", where the sailors gave the rope one big pull. The chorus starts and ends it, with three verses between. A stretch song: its tune runs wider than a beginner's comfortable range, so take the high or low notes gently, or move the key.",
 "language": "en",
 "difficulty": "beginner",
 "genre": [
  "sea shanty",
  "folk",
  "traditional"
 ],
 "style": "straight",
 "tempo": 90,
 "key": "C#m",
 "timeSignature": "4/4",
 "pickupBeats": 1,
