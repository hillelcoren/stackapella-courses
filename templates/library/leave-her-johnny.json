{
 "id": "leave-her-johnny",
 "version": 1,
 "reviewed": true,
 "title": "Leave Her, Johnny",
 "description": "The homeward-bound shanty, as John Short of Watchet sang it to Cecil Sharp, for 2 to 4 singers: the soprano is the shantyman and sings each grumble alone, and everyone answers \"Leave her, Johnny, leave her\" and \"It's time for us to leave her\" in strong, plain chords. Sailors sang it as the ship came into port, to say what they thought of the ship they were about to leave. Three verses at a steady working pace.",
 "language": "en",
 "difficulty": "beginner",
 "genre": [
  "sea shanty",
  "folk",
  "traditional"
 ],
 "style": "free",
 "tempo": 90,
 "key": "Em",
 "timeSignature": "4/4",
 "pickupBeats": 1,
 "credits": {
  "words": "traditional sea shanty (John Short's version, as noted by Cecil Sharp, 1914)",
  "tune": "traditional sea shanty (John Short's version, as noted by Cecil Sharp, 1914)",
  "arrangement": "Stackapella"
 },
 "licence": {
