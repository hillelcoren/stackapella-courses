 "id": "god-rest-ye",
 "version": 1,
 "reviewed": true,
 "title": "God Rest Ye Merry, Gentlemen",
 "description": "The old English carol in E minor, in the four parts of Bramley and Stainer's Christmas Carols New and Old, for 2 to 4 singers: the first verse and its refrain, brisk and bright. The alto walks under the tune with the sharpened D of the minor key, and on \"O tidings of comfort and joy\" the harmony turns to the major before the last \"joy\" comes home to E minor.",
 "language": "en",
 "difficulty": "intermediate",
 "genre": [
  "carol",
  "christmas"
 ],
 "style": "straight",
 "tempo": 120,
 "key": "Em",
 "timeSignature": "4/4",
 "pickupBeats": 1,
 "credits": {
  "words": "Traditional English (as printed by Bramley and Stainer, 1867)",
  "tune": "Traditional English (as printed by Bramley and Stainer, 1867)",
  "arrangement": "Bramley and Stainer's four parts (1867), adapted by Stackapella"
 },
 "licence": {
  "words": "public domain: traditional (the book's index gives the words' source as \"Traditional\")",
  "tune": "public domain: traditional (the index gives the air as \"Traditional\")",
  "arrangement": "the four parts of Christmas Carols New and Old, No. 1 (unsigned, so the music editor's: John Stainer, died 1901; the words editor Henry Ramsden Bramley died 1917; public domain): Stainer's tune, alto, tenor and bass in his key; every harmony part sings one note a syllable where Stainer slurs two (17 places), and nine notes changed so the duet has more thirds, the bass and inner parts have no wide leaps, and the tenor moves mostly by step; breaths written in for beginners",
  "recordings": "synthesized guides",
  "checked": null,
  "source": "H. R. Bramley and John Stainer, Christmas Carols New and Old, first series (London: Novello, Ewer and Co.; first series published November 1867 (The Musical Times, 1 December 1867); this copy a later printing of the 1870s, catalogued [187?], its title page advertising the second series), No. 1, \"God rest you, merry Gentlemen\", p. 2, in four parts in E minor, printed in 2/2 and written here in crotchets (4/4); verse 1 and the chorus as printed under the music (\"rest you\", with the long s modernised); University of California Libraries copy, read from the scan at archive.org/details/christmascarolsn00staiiala/page/n7"
 },
