  "tune": "traditional spiritual, as sung by the Fisk Jubilee Singers (published 1872)",
  "arrangement": "Stackapella (draft), on Theodore F. Seward's harmony"
 },
 "licence": {
  "words": "public domain: traditional, published 1872",
  "tune": "public domain: traditional, published 1872",
  "arrangement": "original, written for Stackapella on the harmony of Theodore F. Seward's four-part answer (public domain: Seward died 1902)",
  "recordings": "synthesized guides",
  "checked": null,
  "source": "tune, words and the answer's harmony from Theodore F. Seward, Jubilee Songs: As Sung by the Jubilee Singers of Fisk University (Biglow & Main, New York, 1872), p. 22, \"Go down, Moses\", in F minor and written here a tone up in G minor; verses 1 and 2 of the 24 printed (pp. 22 to 23), each with the refrain; the last \"go.\", printed a whole bar, is held to the bar line; read from the scan of Emory University's copy at archive.org/details/29208201.4853.emory.edu"
