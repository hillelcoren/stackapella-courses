{
 "id": "go-down-moses",
 "version": 1,
 "reviewed": false,
 "title": "Go Down, Moses",
 "description": "The spiritual as the Fisk Jubilee Singers first printed it, for 2 to 4 singers, in call and answer: the soprano sings each call alone (\"When Israel was in Egypt's land\", \"Go down, Moses\") and everyone answers \"Let my people go\" in harmony. Two verses, each with the refrain. Slow and steady, in a minor key.",
 "language": "en",
 "difficulty": "beginner",
