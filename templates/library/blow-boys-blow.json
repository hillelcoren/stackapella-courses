{
 "id": "blow-boys-blow",
 "version": 1,
 "reviewed": true,
 "title": "Blow, Boys, Blow",
 "description": "A halliard shanty for 2 to 4 singers, as R. R. Terry printed it in 1921: the soprano is the shantyman and sings each solo line alone, and everyone answers \"Blow, boys blow\" and \"Blow my bully boys blow\" in harmony, on Terry's own chords. Six verses about a Yankee ship and what her crew got to eat.",
 "language": "en",
 "difficulty": "beginner",
 "genre": [
  "sea shanty",
  "folk",
  "traditional"
 ],
 "style": "free",
 "tempo": 120,
 "key": "G",
 "timeSignature": "4/4",
 "pickupBeats": 1,
 "credits": {
  "words": "traditional sea shanty (as printed by R. R. Terry, 1921)",
  "tune": "traditional sea shanty (as printed by R. R. Terry, 1921)",
  "arrangement": "Stackapella, on R. R. Terry's harmony"
 },
 "licence": {
  "words": "public domain: traditional, verses 1, 2, 5, 6, 7 and 8 and the chorus as printed by R. R. Terry, The Shanty Book, Part I (1921), No. 15; his verses 3 and 4 are left out",
  "tune": "public domain: traditional, printed 1921 by Richard Runciman Terry (died 1938)",
  "arrangement": "original, written for Stackapella on the harmony of Terry's piano accompaniment (public domain: Terry died 1938): the soprano is his voice part note for note, the first ending's pause written out as a held note and one more bar; the alto, tenor and bass sing the chorus lines only, one note a syllable, on his chords, the bass on his left hand's notes; a whole tone higher; breaths written in for beginners",
  "recordings": "synthesized guides",
  "checked": null,
  "source": "tune, words and harmony from Richard Runciman Terry, The Shanty Book, Part I: Sailor Shanties (London: J. Curwen & Sons, 1921), No. 15, \"Blow my bully boys\" (Halliard shanty), pp. 32 and 33, the voice part and the piano accompaniment, with his note on pp. xiv and xv; printed in F major, 4/4, crotchet = 150, and written here a whole tone higher, in G; verses 1, 2, 5, 6, 7 and 8 of Terry's eight, with his main tune (not the variant of the last line in his note); read from the University of Toronto Faculty of Music Library copy at archive.org/details/shantybooksailor00terr (scan pages n53, n54 and n20)"
 },
