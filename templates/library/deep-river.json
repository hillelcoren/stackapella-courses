{
 "id": "deep-river",
 "version": 1,
 "reviewed": true,
 "title": "Deep River",
 "description": "Harry T. Burleigh's setting of the spiritual for mixed chorus, published in 1914, for 4 singers, in his own four parts. The alto sings the tune, twice: the soprano waits eight bars, then floats a slow \"Deep, deep river\" above it. In the verse, \"Oh, don't you want to go\", the soprano takes the top line up to a loud high note before the soft, slow ending. Very slow and smooth.",
 "language": "en",
 "difficulty": "intermediate",
 "genre": [
  "spiritual",
  "gospel",
  "choral"
 ],
 "style": "straight",
 "tempo": 60,
 "key": "Eb",
 "timeSignature": "4/4",
 "pickupBeats": 0,
 "credits": {
  "words": "traditional spiritual, as H. T. Burleigh set them (1914)",
  "tune": "traditional spiritual, as arranged by H. T. Burleigh (1914)",
  "arrangement": "H. T. Burleigh's own four parts (1914), adapted by Stackapella"
 },
 "licence": {
  "words": "public domain: traditional; Burleigh's setting published 1914",
  "tune": "public domain: traditional, in the form Burleigh published in 1914; he died in 1949",
  "arrangement": "Harry T. Burleigh's own four voice parts as G. Schirmer published them in 1914 (public domain: published 1914; Burleigh died 1949), sung a cappella without the rehearsal piano: where the tenors or basses divide, one printed line is sung (the one with the chord's root or third); every pitch as printed but two cadence notes, Bass II's low E-flat in bars 8 and 27, sung an octave up; breaths written in for beginners (the alto's \"Jordan\" in bars 4 and 12 shortened by half a beat for one); \"promis'd\" spelled \"promised\"; the final fermata sung four beats",
  "recordings": "synthesized guides",
  "checked": null,
  "source": "H. T. Burleigh, Deep River, from \"Jubilee Songs\" of the United States of America, arranged for mixed voices with piano for rehearsal only (New York: G. Schirmer, 8vo Choruses No. 5815, plate 24603, \"Copyright, 1914, by G. Schirmer\"), dedicated \"To the Chorus of the Schola Cantorum, New York, Kurt Schindler, Conductor\", pp. 1 to 3, in E-flat, Lento; read from the scan at IMSLP #999165 (Deep River/Dig My Grave, imslp.org/wiki/Special:ReverseLookup/999165), whose pp. 4 to 7 are another piece"
 },
