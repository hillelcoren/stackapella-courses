 "id": "jerusalem",
 "version": 1,
 "reviewed": true,
 "title": "Jerusalem",
 "description": "William Blake's \"And did those feet in ancient time\" to Hubert Parry's tune of 1916, for 2 to 4 singers: the first verse, broad and steady, a breath at every line. Parry wrote it as a unison song with accompaniment; here the tune is his, the bass follows his left hand, and the new alto and tenor sing his harmony, moving mostly by step.",
 "language": "en",
 "difficulty": "intermediate",
 "genre": [
  "hymn"
 ],
 "style": "straight",
 "tempo": 60,
 "key": "D",
 "timeSignature": "3/4",
 "pickupBeats": 1.5,
 "credits": {
  "words": "William Blake (c. 1804), from the preface to Milton",
  "tune": "Hubert Parry, \"Jerusalem\" (1916)",
  "arrangement": "Parry's own accompaniment (1916), set for four voices by Stackapella"
 },
 "licence": {
  "words": "public domain: Blake died in 1827",
  "tune": "public domain: Parry's, published 1916 (he died in 1918)",
  "arrangement": "Parry's unison song with accompaniment (public domain: published 1916, Parry died 1918), in his key: the soprano is his tune, the last note shortened to end on the bar line; the bass is the lowest note of his accompaniment (an octave or two up where it lies under the bass range), five notes changed; the alto and tenor are Stackapella's, on his harmony; breaths written in for beginners. Accepted exceptions (singable.py): the tune's own low B on \"green?\", as Parry wrote it, a minor third under the beginner soprano range; the alto sings G and the tenor D under it.",
  "recordings": "synthesized guides",
  "checked": null,
  "source": "C. Hubert H. Parry's unison song \"Jerusalem\" (\"And did those feet in ancient time\", J. Curwen & Sons, 1916), his voice part and accompaniment, in D, verse 1 (marked Solo in Curwen's print). Read from Songs of Praise (London: Oxford University Press, 1925), No. 204 \"Jerusalem\", pp. 326 to 328, which prints Parry's setting (credited to him alone, from Curwen Edition No. 6333): archive.org/details/songsofpraise0000unse_r2d5, scan pages n341 to n343. Checked against Curwen's own plate as reproduced in The Old Country: A Book of Love and Praise of England, ed. Ernest Rhys (London: J. M. Dent, 1917), pp. 18 to 19, \"Set to Music by C. Hubert H. Parry ... Published by J. Curwen & Sons, Ltd.\": archive.org/details/oldcountrybookof0000erne, scan pages n23 and n24 (the words are as printed there); and The Hymnary of the United Church of Canada (Toronto: United Church Publishing House, 1930), No. 522, \"From Curwen Edition No. 40009\": archive.org/details/hymnaryofunitedc0000gene_w4m3, scan pages n594 and n595"
 },
