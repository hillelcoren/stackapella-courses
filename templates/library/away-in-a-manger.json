{
 "id": "away-in-a-manger",
 "version": 1,
 "reviewed": false,
 "title": "Away in a Manger",
 "description": "The children's Christmas carol to William J. Kirkpatrick's tune of 1895, the one sung in Britain, Ireland and Canada, for 2 to 4 singers: the first verse, slow and gentle. The alto sings Kirkpatrick's second voice, smoothed in places, mostly in sixths and thirds under the tune; the bass sings the low notes of his accompaniment, and the tenor fills in the chord, mostly on G. A lullaby to sing together.",
 "language": "en",
 "difficulty": "beginner",
 "genre": [
  "carol",
  "christmas"
 ],
 "style": "straight",
 "tempo": 84,
 "key": "G",
 "timeSignature": "3/4",
 "pickupBeats": 1,
 "credits": {
  "words": "Anonymous (in print by 1882), as printed in Joy and Praise (1908)",
  "tune": "\"Cradle Song\", William J. Kirkpatrick (1895)",
  "arrangement": "Kirkpatrick's own duet and accompaniment (1895), set for four voices by Stackapella"
 },
 "licence": {
  "words": "public domain: anonymous, in print by 1882",
  "tune": "public domain: Kirkpatrick's, published 1895 (he died in 1921)",
  "arrangement": "Kirkpatrick's duet and accompaniment (public domain: published 1895, Kirkpatrick died 1921), a whole tone higher: the soprano and alto are his two voices, one note to a syllable, eleven alto notes changed so the line moves by step; the bass is his left hand's lowest note, sung on where it rests, two notes changed; the tenor is Stackapella's, on his harmony; breaths written in for beginners",
  "recordings": "synthesized guides",
  "checked": null,
  "source": "Wm. J. Kirkpatrick and J. H. Fillmore, Joy and Praise: A Sunday-School Song Book (Cincinnati and New York: Fillmore Music House, [1908]), No. 174, p. 181, \"Luther's Cradle Hymn (Solo or Duet)\", music by Wm. J. Kirkpatrick, \"Copyright, 1895, by Wm. J. Kirkpatrick\": the tune, his second voice and his left-hand accompaniment, in F, written here a whole tone higher in G; verse 1 as printed under the music. Princeton Theological Seminary Library copy, archive.org/details/joypraisesundays00kirk/page/n184. Checked against the same setting in The Church Hymnal Revised, ed. Charles L. Hutchins (Boston: The Parish Choir, 1920), No. 643 \"Manger\", pp. 592 to 593, archive.org/details/churchhymnalrevi00hutc"
 },
