  "tune": "Daniel E. Kelley (1870s)",
  "arrangement": "Stackapella (draft)"
 },
 "licence": {
  "words": "public domain: Higley died in 1911 and the words were printed by 1910",
  "tune": "public domain: Kelley died in 1905",
  "arrangement": "original, written for Stackapella",
  "recordings": "synthesized guides",
  "checked": null,
