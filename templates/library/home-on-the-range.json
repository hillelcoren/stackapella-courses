{
 "id": "home-on-the-range",
 "version": 1,
 "reviewed": false,
 "title": "Home on the Range",
 "description": "The cowboy song, for 2 to 4 singers: the verse and the refrain, as a gentle waltz. The soprano sings the melody, the alto sings the words beneath it in thirds and sixths, the tenor fills the chord, and the bass holds the roots on \"oo\", singing the words only for \"Home, home on the range\".",
 "language": "en",
 "difficulty": "beginner",
 "genre": [
