{
 "song": "shchedryk",
 "templateVersion": 5,
 "sungLanguage": "uk",
 "lines": [
  {
   "section": 0,
   "phrase": 0,
   "startBeat": 0,
   "endBeat": 6,
   "sung": "Щедрик, щедрик, щедрівочка,",
   "en": "Shchedryk, shchedryk (Generous Evening), a little New Year song,",
   "es": "Shchedryk, shchedryk (Noche Generosa), una cancioncita de Año Nuevo,"
  },
  {
   "section": 0,
   "phrase": 1,
   "startBeat": 6,
   "endBeat": 12,
   "sung": "Прилетіла ластівочка,",
   "en": "a little swallow has flown in,",
   "es": "ha llegado volando una golondrinita,"
  },
  {
   "section": 1,
   "phrase": 0,
   "startBeat": 12,
   "endBeat": 18,
   "sung": "Стала собі щебетати,",
   "en": "she began to twitter away,",
   "es": "se puso a trinar,"
  },
  {
   "section": 1,
   "phrase": 1,
   "startBeat": 18,
   "endBeat": 24,
   "sung": "Господаря викликати:",
   "en": "calling out the master of the house:",
   "es": "llamando al dueño de la casa:"
  },
  {
   "section": 2,
   "phrase": 0,
   "startBeat": 24,
   "endBeat": 30,
   "sung": "Вийди, вийди, господарю,",
   "en": "Come out, come out, master,",
   "es": "Sal, sal, dueño de la casa,"
  },
  {
   "section": 2,
   "phrase": 1,
   "startBeat": 30,
   "endBeat": 36,
   "sung": "Подивися на кошару,",
   "en": "take a look at the sheepfold,",
   "es": "mira el redil,"
  },
  {
   "section": 3,
   "phrase": 0,
   "startBeat": 36,
   "endBeat": 42,
   "sung": "Там овечки покотились,",
   "en": "the ewes there have given birth,",
   "es": "allí las ovejas han parido,"
  },
  {
   "section": 3,
   "phrase": 1,
   "startBeat": 42,
   "endBeat": 48,
   "sung": "А ягнички народились.",
   "en": "and little lambs have been born.",
   "es": "y han nacido corderitos."
  },
  {
   "section": 3,
   "phrase": 2,
   "startBeat": 48,
   "endBeat": 54,
   "sung": "В тебе товар весь хороший,",
   "en": "All your livestock is good,",
   "es": "Todo tu ganado es bueno,"
  },
  {
   "section": 3,
   "phrase": 3,
   "startBeat": 54,
   "endBeat": 60,
   "sung": "Будеш мати мірку грошей.",
   "en": "you will have a measure of money.",
   "es": "tendrás una medida de dinero."
  },
  {
   "section": 3,
   "phrase": 4,
   "startBeat": 60,
   "endBeat": 66,
   "sung": "Хоч не гроші, то полова:",
   "en": "If not money, then chaff from the threshing:",
   "es": "Si no es dinero, paja de la trilla:"
  },
  {
   "section": 3,
   "phrase": 5,
   "startBeat": 66,
   "endBeat": 72,
   "sung": "В тебе жінка чорноброва.",
   "en": "you have a dark-browed wife.",
   "es": "tienes una esposa de cejas negras."
  },
  {
   "section": 4,
   "phrase": 0,
   "startBeat": 72,
   "endBeat": 78,
   "sung": "Щедрик, щедрик, щедрівочка,",
   "en": "Shchedryk, shchedryk (Generous Evening), a little New Year song,",
   "es": "Shchedryk, shchedryk (Noche Generosa), una cancioncita de Año Nuevo,"
  },
  {
   "section": 4,
   "phrase": 1,
   "startBeat": 78,
   "endBeat": 87,
   "sung": "Прилетіла ластівочка.",
   "en": "a little swallow has flown in.",
   "es": "ha llegado volando una golondrinita."
  }
 ]
