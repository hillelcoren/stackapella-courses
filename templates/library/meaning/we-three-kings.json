    {
      "section": 1,
      "phrase": 2,
      "startBeat": 72,
      "endBeat": 84,
      "sung": "Westward leading, Still proceeding,",
      "es": "que guías hacia el oeste y sigues avanzando,"
    },
    {
      "section": 1,
      "phrase": 3,
