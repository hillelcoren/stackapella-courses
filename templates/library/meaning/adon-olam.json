{
  "song": "adon-olam",
  "templateVersion": 2,
  "sungLanguage": "he",
  "lines": [
    {
      "section": 0,
      "phrase": 0,
      "startBeat": 0,
      "endBeat": 8.5,
      "sung": "Adon olam asher malach,",
      "en": "Master of the world, who was King",
      "es": "Amo del mundo, que fue Rey"
    },
    {
      "section": 0,
      "phrase": 1,
      "startBeat": 8.5,
      "endBeat": 16.5,
      "sung": "b'terem kol yetzir nivra.",
      "en": "before anything at all was formed.",
      "es": "antes de que nada en absoluto fuera formado."
    },
    {
      "section": 0,
      "phrase": 2,
      "startBeat": 16.5,
      "endBeat": 24,
      "sung": "L'et naasa vecheftzo kol,",
      "en": "When everything was made by His will,",
      "es": "Cuando todo fue hecho por Su voluntad,"
    },
    {
      "section": 0,
      "phrase": 3,
      "startBeat": 24,
      "endBeat": 36,
      "sung": "azai melech shemo nikra.",
      "en": "then He was called King.",
      "es": "entonces fue llamado Rey."
    },
    {
      "section": 1,
      "phrase": 0,
      "startBeat": 36,
      "endBeat": 44.5,
      "sung": "Veacharei kichlot hakol,",
      "en": "And when everything comes to an end,",
      "es": "Y cuando todo llegue a su fin,"
    },
    {
      "section": 1,
      "phrase": 1,
      "startBeat": 44.5,
      "endBeat": 52.5,
      "sung": "levado yimloch nora.",
      "en": "He alone, the awesome One, will reign.",
      "es": "solo Él, el Temible, reinará."
    },
    {
      "section": 1,
      "phrase": 2,
      "startBeat": 52.5,
      "endBeat": 60,
      "sung": "Vehu haya vehu hove,",
      "en": "He was, He is,",
      "es": "Él fue, Él es"
    },
    {
      "section": 1,
      "phrase": 3,
      "startBeat": 60,
      "endBeat": 72,
      "sung": "vehu yihye betifara.",
      "en": "and He will be, in glory.",
      "es": "y Él será, en gloria."
    },
    {
      "section": 2,
      "phrase": 0,
      "startBeat": 72,
      "endBeat": 80.5,
      "sung": "Vehu echad veein sheni",
      "en": "He is One, and there is no second",
      "es": "Él es Uno, y no hay un segundo"
    },
    {
      "section": 2,
      "phrase": 1,
      "startBeat": 80.5,
      "endBeat": 88.5,
      "sung": "lehamshilo lehachbira.",
      "en": "to compare with Him or set beside Him.",
      "es": "que se le compare o se ponga a Su lado."
    },
    {
      "section": 2,
      "phrase": 2,
      "startBeat": 88.5,
      "endBeat": 96,
      "sung": "Beli reshit beli tachlit,",
      "en": "Without beginning, without end;",
      "es": "Sin principio, sin fin;"
    },
    {
      "section": 2,
      "phrase": 3,
      "startBeat": 96,
      "endBeat": 108,
      "sung": "velo haoz vehamisra.",
      "en": "strength and rule are His.",
      "es": "Suyos son la fuerza y el dominio."
    },
    {
      "section": 3,
      "phrase": 0,
      "startBeat": 108,
      "endBeat": 116.5,
      "sung": "Beyado afkid ruchi",
      "en": "Into His hand I entrust my spirit",
      "es": "En Su mano encomiendo mi espíritu"
    },
    {
      "section": 3,
      "phrase": 1,
      "startBeat": 116.5,
      "endBeat": 124.5,
      "sung": "b'et ishan veaira.",
      "en": "when I sleep and when I wake.",
      "es": "cuando duermo y cuando despierto."
    },
    {
      "section": 3,
      "phrase": 2,
      "startBeat": 124.5,
      "endBeat": 132,
      "sung": "Veim ruchi geviyati,",
      "en": "And with my spirit, my body too.",
      "es": "Y con mi espíritu, también mi cuerpo."
    },
    {
      "section": 3,
      "phrase": 3,
      "startBeat": 132,
      "endBeat": 140.5,
      "sung": "Adoshem li velo ira.",
      "en": "Hashem is with me; I will not fear.",
      "es": "Hashem está conmigo; no temeré."
    }
  ]
}
