{
 "id": "i-will-bow-and-be-simple",
 "version": 1,
 "reviewed": true,
 "title": "I Will Bow and Be Simple",
 "description": "A Shaker song of humility, \"I will bow and be simple, I will bow and be free\", in Mary Hazzard's songbook, signed \"North Family\", undated, between songs dated 1851 and 1852, for 2 to 4 singers. The soprano sings the tune, the alto and tenor sing the words close beneath it, and the bass holds the roots on \"oo\"; each strain is sung twice, as the book marks it.",
 "difficulty": "beginner",
 "genre": [
  "shaker",
  "folk",
  "sacred"
 ],
 "style": "straight",
 "tempo": 100,
 "key": "C",
 "timeSignature": "4/4",
 "pickupBeats": 2,
 "language": "en",
 "credits": {
  "words": "Shaker song (Mary Hazzard's songbook, undated, between songs dated 1851 and 1852)",
  "tune": "Shaker song (Mary Hazzard's songbook, undated, between songs dated 1851 and 1852)",
  "arrangement": "Stackapella"
 },
 "licence": {
  "words": "public domain: a Shaker song with no maker named, in Mary Hazzard's manuscript songbook (begun 1847), undated, between songs dated 1851 and 1852",
  "tune": "public domain: a Shaker song with no maker named, in Mary Hazzard's manuscript songbook (begun 1847), undated, between songs dated 1851 and 1852",
  "arrangement": "original, written for Stackapella",
  "recordings": "synthesized guides",
  "source": "melody and words from Mary Hazzard's manuscript book \"A Collection of Extra Songs of Various Kinds Written and Pricked For the Purpose of Retaining them\" (begun February 7th 1847), Winterthur Library, ASC 893, catalogue https://winterthur.libraryhost.com/repositories/2/archival_objects/95, page image 128 (the manuscript's page 108), with no heading (its first line \"I will bow & be simple I will bow and be free\"), signed \"North Family\" with no village, giver or date (the nearest dated songs are 1851 on the manuscript's page 105 and 1852 on its page 116); in Shaker letteral notation in C in 2/4 (the head frame has no time figure; every bar holds four eighths), sung here in C in 4/4 with every value doubled; every pitch as written, the opening \"I\" on middle C, a tone under the soprano's range; both strains sung twice, as the repeat signs mark them; breaths written in for beginners: \"free,\" ends half a beat early and the \"I\" after it comes in half a beat late, and \"tree,\" \"yoke,\" and \"rock,\" before each repeat give up their second beat; spelling modernised: \"&\" sung \"and\"; in the second strain the note for \"be\" (\"bow & be broken\") is read as the e written over a scraped-out g; read from the scan of the whole book saved by Hillel from the Winterthur Library. Courtesy Winterthur Museum, Garden & Library.",
  "checked": null
 },
