{
 "id": "heavenly-treasures",
 "version": 1,
 "reviewed": true,
 "title": "I Am Fill'd with Heavenly Treasures",
 "description": "A short Shaker song from Mary Hazzard's songbook, \"Sung by Jack thro Abram P. on the holy Mount\" on August 30th (1847, by the dated song above it on the page), for 2 to 4 singers, in a lilting 6/8. After \"I am fill'd with heavenly treasures\" and each \"Praise, praise\", the soprano carries the last word through a run of wordless notes while the alto and tenor sing \"oo\" beneath and the bass holds the roots.",
 "difficulty": "beginner",
 "genre": [
  "shaker",
  "folk",
  "sacred"
 ],
 "style": "straight",
 "tempo": 60,
 "key": "Em",
 "timeSignature": "6/8",
 "pickupBeats": 0,
 "language": "en",
 "credits": {
  "words": "Shaker song (Mary Hazzard's songbook, about 1847)",
  "tune": "Shaker song (Mary Hazzard's songbook, about 1847)",
  "arrangement": "Stackapella"
 },
 "licence": {
  "words": "public domain: a Shaker song dated \"Aug 30th\" on the page, in 1847 by the dated song above it, in Mary Hazzard's manuscript songbook (begun 1847)",
  "tune": "public domain: a Shaker song dated \"Aug 30th\" on the page, in 1847 by the dated song above it, in Mary Hazzard's manuscript songbook (begun 1847)",
  "arrangement": "original, written for Stackapella",
  "recordings": "synthesized guides",
  "source": "melody and words from Mary Hazzard's manuscript book \"A Collection of Extra Songs of Various Kinds Written and Pricked For the Purpose of Retaining them\" (begun February 7th 1847), Winterthur Library, ASC 893, catalogue https://winterthur.libraryhost.com/repositories/2/archival_objects/95, page image 43 (the manuscript's page 23), with no heading (its first line \"I am fill'd with heavenly treasures\"), signed \"Sung by Jack thro Abram P. on the holy Mount Aug 30th\"; the year is from the song above it on the same page, \"August 30th 1847. Sung by the Savior on the Holy Mount thro Abm Perkins\"; in Shaker letteral notation in A minor in 6/8 (head frame \"5\"; every bar holds six eighths, grouped in threes), sung here a fourth lower, in E minor, in 6/8 with the values as written; every pitch as written; both strains written out with two endings and sung twice, as the repeat signs mark them; the dashes after \"treasures\" and \"praise\" are sung as the last syllable held through the wordless notes; breaths written in for beginners: the last note of each line (\"b.\", or the second \"a.\") gives up half a beat; spelling as written, \"fill'd\" kept as sung; read from the scan of the whole book saved by Hillel from the Winterthur Library. Courtesy Winterthur Museum, Garden & Library.",
  "checked": null
 },
