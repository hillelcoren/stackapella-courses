  "tune": "anonymous, printed as \"May Bells\" in Hollis Dann's Fourth Year Music (1916)",
  "arrangement": "Stackapella (round setting)"
 },
 "licence": {
  "words": "public domain: printed 1916, no author named",
  "tune": "public domain: printed 1916, no composer named",
  "arrangement": "original round setting",
  "recordings": "synthesized guides",
  "checked": null,
  "source": "Hollis Dann Music Course, Fourth Year Music (American Book Company, New York, 1916), p. 115, \"May Bells\", a round for two voices (II entering at bar 5), in E-flat, written here a fourth lower, in B-flat, for up to four voices entering four bars apart; read from the scan at archive.org/details/hollisdannmusic01danngoog (leaf n119). Hollis Dann, the compiler, died in 1939."
 },
