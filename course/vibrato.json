    "title": { "en": "Vibrato" },
    "units": [
        {
            "id": "vib-swing-and-settle",
            "title": { "en": "Swing and settle" },
            "colour": 5,
            "lessons": [
                {
                    "id": "vib-1-swing",
                    "title": { "en": "Swing your voice" },
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": { "en": "You're about to see your voice draw a wave. Keep it soft, in the middle of your voice." },
                            "steps": [
                                { "title": { "en": "Hum, softly" }, "detail": { "en": "\"Mm\" or \"oo\", at a medium volume" } },
                                { "title": { "en": "Swing up and down" }, "detail": { "en": "Tiny slurs, jaw and belly still" } },
                                { "title": { "en": "Then settle" }, "detail": { "en": "One easy long note, nothing steered" } }
                            ],
                            "listen": { "tempo": 60, "notes": [{ "beat": 1, "length": 6, "step": 0, "lyric": "mm" }], "turn": false, "drone": { "step": 0 } },
                            "visual": "vibrato",
                            "reviewed": false
                        },
                        {
                            "kind": "play",
                            "text": { "en": "Hum one easy long note over the drone. Let it be calm." },
                            "exercise": { "tempo": 60, "notes": [{ "beat": 2, "length": 6, "step": 0, "lyric": "mm" }], "turn": false, "drone": { "step": 0 }, "score": "hold", "show": "vibrato" },
                            "measures": { "en": "Your stars are for a steady, easy note. Next: a calm, steady note to build on." }
                        }
                    ]
                },
                {
                    "id": "vib-1-easy",
                    "title": { "en": "The easy long note" },
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": { "en": "A vibrato grows from steady breath and a free throat. It starts with an easy note." },
                            "steps": [
                                { "title": { "en": "Sigh into \"ah\"" }, "detail": { "en": "Like a relieved sigh, then hold it" } },
                                { "title": { "en": "Medium volume" }, "detail": { "en": "Not quiet and breathy, never loud" } },
                                { "title": { "en": "Check your jaw" }, "detail": { "en": "Rest a fingertip on your chin. It should stay still" } }
                            ],
                            "listen": { "tempo": 60, "notes": [{ "beat": 1, "length": 6, "step": 0, "lyric": "ah" }], "turn": false, "drone": { "step": 0 } },
                            "visual": "steady",
                            "reviewed": false
                        },
                        {
                            "kind": "play",
                            "text": { "en": "Sigh into \"ah\" and hold it, easy and steady, over the drone." },
                            "exercise": { "tempo": 60, "notes": [{ "beat": 2, "length": 6, "step": 0, "lyric": "ah" }], "turn": false, "drone": { "step": 0 }, "score": "hold", "show": "vibrato" },
                            "measures": { "en": "Your stars are for how long you held the note on pitch, and how steadily. Did your chin stay still?" }
                        }
                    ]
                },
                {
                    "id": "vib-1-laser",
                    "title": { "en": "A calm, straight line" },
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": { "en": "A straight tone is how chords ring. It's light and calm, never a held throat." },
                            "steps": [
                                { "title": { "en": "Start from the easy note" }, "detail": { "en": "The same sigh, the same ease" } },
                                { "title": { "en": "Keep the line flat" }, "detail": { "en": "No wave, like a calm horizon" } },
                                { "title": { "en": "Stay light" }, "detail": { "en": "If your throat tightens, let the wave back in" } }
                            ],
                            "listen": { "tempo": 60, "notes": [{ "beat": 1, "length": 4, "step": 0, "lyric": "oo" }], "turn": false, "drone": { "step": 0 } },
                            "visual": "steady",
                            "reviewed": false
                        },
                        {
                            "kind": "play",
                            "text": { "en": "Hold a calm, straight \"oo\" for 4 beats." },
                            "exercise": { "tempo": 60, "notes": [{ "beat": 2, "length": 4, "step": 0, "lyric": "oo" }], "turn": false, "drone": { "step": 0 }, "score": "hold" }
                        },
                        {
                            "kind": "play",
                            "text": { "en": "Now 6 beats, still light." },
                            "exercise": { "tempo": 60, "notes": [{ "beat": 2, "length": 6, "step": 0, "lyric": "oo" }], "turn": false, "drone": { "step": 0 }, "score": "hold" }
                        },
                        {
                            "kind": "play",
                            "text": { "en": "And 8 beats. Breathe whenever you need to." },
                            "exercise": { "tempo": 60, "notes": [{ "beat": 2, "length": 8, "step": 0, "lyric": "oo" }], "turn": false, "drone": { "step": 0 }, "score": "hold" },
                            "measures": { "en": "Your stars are for how long you held it on pitch, and how steadily." }
                        }
                    ]
                },
                {
                    "id": "vib-1-challenge",
                    "title": { "en": "Straight through a line" },
                    "challenge": true,
                    "steps": [
