                            "kind": "learn",
                            "headline": { "en": "Hymns and choirs often sing straight, so every chord rings clear." },
                            "steps": [
                                { "title": { "en": "Listen to the line" }, "detail": { "en": "Amazing Grace, the first line" } },
                                { "title": { "en": "Keep each long note calm" }, "detail": { "en": "\"maz-\", \"grace\", \"sweet\", \"sound\"" } },
                                { "title": { "en": "Light, not held" }, "detail": { "en": "Straight comes from ease, not effort" } }
                            ],
                            "listen": {
                                "tempo": 72,
                                "notes": [
                                    { "beat": 0, "length": 1, "step": -5, "lyric": "A-" },
                                    { "beat": 1, "length": 2, "step": 0, "lyric": "maz-" },
