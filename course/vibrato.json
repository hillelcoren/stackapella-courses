            "lessons": [
                {
                    "id": "vib-1-swing",
                    "title": {
                        "en": "Swing your voice"
                    },
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": {
                                "en": "You're about to see your voice draw a wave. Keep it soft, in the middle of your voice."
                            },
                            "steps": [
                                {
                                    "title": {
                                        "en": "Hum, softly"
                                    },
                                    "detail": {
                                        "en": "\"Mm\" or \"oo\", at a medium volume"
                                    }
                                },
                                {
                                    "title": {
                                        "en": "Swing up and down"
                                    },
                                    "detail": {
                                        "en": "Tiny slurs, jaw and belly still"
                                    }
                                },
                                {
                                    "title": {
                                        "en": "Then settle"
                                    },
                                    "detail": {
                                        "en": "One easy long note, nothing steered"
                                    }
                                }
                            ],
                            "listen": {
                                "tempo": 60,
                                "notes": [
                                    {
                                        "beat": 1,
                                        "length": 6,
                                        "step": 0,
                                        "lyric": "mm"
                                    }
                                ],
                                "turn": false,
                                "drone": {
                                    "step": 0
                                }
                            },
                            "visual": "vibrato",
                            "reviewed": false
                        },
                        {
                            "kind": "wave",
                            "text": {
                                "en": "Follow the ribbon on a soft hum: a slow swing, then quicker and smaller."
                            },
                            "exercise": {
                                "tempo": 60,
                                "lead": 2,
                                "step": 0,
                                "lyric": "mm",
                                "drone": {
                                    "step": 0
                                },
