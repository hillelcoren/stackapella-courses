                                    { "beat": 3.5, "length": 0.5, "step": 0 },
                                    { "beat": 4, "length": 2, "step": 4, "lyric": "grace," },
                                    { "beat": 6, "length": 1, "step": 2, "lyric": "how" },
                                    { "beat": 7, "length": 2, "step": 0, "lyric": "sweet" },
                                    { "beat": 9, "length": 1, "step": -3, "lyric": "the" },
                                    { "beat": 10, "length": 3, "step": -5, "lyric": "sound" }
                                ],
                                "turn": false
                            },
                            "visual": "phrase",
                            "reviewed": false
                        },
                        {
