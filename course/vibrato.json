                                        "cents": 30
                                    }
                                ],
                                "generous": true
                            }
                        },
                        {
                            "kind": "wave",
                            "text": {
                                "en": "Now one easy long hum. Nothing to steer: let it be."
                            },
                            "exercise": {
                                "tempo": 60,
                                "lead": 2,
                                "step": 0,
                                "lyric": "mm",
                                "drone": {
                                    "step": 0
                                },
                                "target": [
                                    {
                                        "seconds": 6,
                                        "kind": "free"
                                    }
                                ],
                                "combo": false
                            },
                            "measures": {
                                "en": "Your stars are for an easy, steady note. A real vibrato isn't steered: it grows from a note like this. Next: the easy note."
                            }
                        }
                    ]
                },
                {
                    "id": "vib-1-easy",
                    "title": {
                        "en": "The easy long note"
                    },
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": {
                                "en": "A vibrato grows from steady breath and a free throat. It starts with an easy note."
                            },
                            "steps": [
                                {
                                    "title": {
                                        "en": "Sigh into \"ah\""
                                    },
                                    "detail": {
                                        "en": "Like a relieved sigh, then hold it"
                                    }
                                },
                                {
                                    "title": {
                                        "en": "Medium volume"
                                    },
                                    "detail": {
                                        "en": "Not quiet and breathy, never loud"
                                    }
                                },
                                {
                                    "title": {
                                        "en": "Check your jaw"
                                    },
                                    "detail": {
                                        "en": "Rest a fingertip on your chin. It should stay still"
                                    }
                                }
                            ],
                            "listen": {
                                "tempo": 60,
                                "notes": [
                                    {
                                        "beat": 1,
                                        "length": 6,
                                        "step": 0,
                                        "lyric": "ah"
                                    }
                                ],
                                "turn": false,
                                "drone": {
                                    "step": 0
                                }
                            },
                            "visual": "steady",
                            "reviewed": false
                        },
                        {
                            "kind": "wave",
                            "text": {
                                "en": "Sigh into \"ah\" and hold it, easy and steady, over the drone."
                            },
                            "exercise": {
                                "tempo": 60,
                                "lead": 2,
                                "step": 0,
                                "lyric": "ah",
                                "drone": {
                                    "step": 0
                                },
                                "target": [
                                    {
                                        "seconds": 6,
                                        "kind": "free"
                                    }
                                ],
                                "combo": false
                            },
                            "measures": {
                                "en": "Your stars are for a steady note held all the way. Did your chin stay still?"
                            }
                        }
                    ]
                },
                {
                    "id": "vib-1-laser",
                    "title": {
                        "en": "A calm, straight line"
                    },
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": {
                                "en": "A straight tone is how chords ring. It's light and calm, never a held throat."
                            },
                            "steps": [
                                {
                                    "title": {
                                        "en": "Start from the easy note"
                                    },
                                    "detail": {
                                        "en": "The same sigh, the same ease"
                                    }
                                },
                                {
                                    "title": {
                                        "en": "Keep the line flat"
                                    },
                                    "detail": {
                                        "en": "No wave, like a calm horizon"
                                    }
                                },
                                {
                                    "title": {
                                        "en": "Stay light"
                                    },
                                    "detail": {
                                        "en": "If your throat tightens, let the wave back in"
                                    }
                                }
                            ],
                            "listen": {
                                "tempo": 60,
                                "notes": [
                                    {
                                        "beat": 1,
                                        "length": 4,
                                        "step": 0,
                                        "lyric": "oo"
                                    }
                                ],
                                "turn": false,
                                "drone": {
                                    "step": 0
                                }
                            },
                            "visual": "steady",
                            "reviewed": false
                        },
                        {
                            "kind": "wave",
                            "text": {
                                "en": "Hold a calm, straight \"oo\" for 4 seconds."
                            },
                            "exercise": {
                                "tempo": 60,
                                "lead": 2,
                                "step": 0,
