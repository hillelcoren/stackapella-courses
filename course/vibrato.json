                            "exercise": {
                                "tempo": 60,
                                "lead": 2,
                                "step": 0,
                                "lyric": "oo",
                                "drone": {
                                    "step": 0
                                },
                                "target": [
                                    {
                                        "seconds": 6,
                                        "kind": "straight"
                                    }
                                ]
                            }
                        },
                        {
                            "kind": "wave",
                            "text": {
                                "en": "And 8 seconds. Breathe whenever you need to."
                            },
                            "exercise": {
                                "tempo": 60,
                                "lead": 2,
                                "step": 0,
                                "lyric": "oo",
                                "drone": {
                                    "step": 0
                                },
                                "target": [
                                    {
                                        "seconds": 8,
                                        "kind": "straight"
                                    }
                                ]
                            },
                            "measures": {
                                "en": "Your stars are for how long it stayed straight. If your throat tightens, let the wave back in."
                            }
                        }
                    ]
