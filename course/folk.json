                                { "title": { "en": "Hear it ring" }, "detail": { "en": "Your note and the drone, as one sound" } },
                                { "title": { "en": "A plain, easy tone" }, "detail": { "en": "Like a relaxed sigh, never squeezed" } },
                                { "title": { "en": "A light wave is fine" }, "detail": { "en": "Softer, never held still" } }
                            ],
                            "listen": {
                                "tempo": 60,
