                {
                    "id": "folk-1-ring",
                    "title": { "en": "Ring with the drone" },
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": {
                                "en": "A note a little out of tune beats against the drone, a wobble in the sound. In tune, the wobble goes and the two ring as one."
                            },
