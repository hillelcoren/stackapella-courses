{
    "id": "humming-and-lip-trills",
    "version": 1,
    "reviewed": false,
    "title": {"en": "Humming and lip trills"},
    "units": [
        {
            "id": "hum-trill",
            "title": {"en": "The lip trill"},
            "colour": 1,
            "lessons": [
                {
                    "id": "hum-1-coaster",
                    "title": {"en": "A roller coaster"},
                    "fact": {"id": "hum-one-buzz-or-two", "text": {"en": "A hum has one buzz, your vocal folds. A lip trill has two: the lips flutter too. A 2014 study of 23 people proposed sorting part-closed voice exercises into these two families."}, "source": {"en": "Andrade PA, Wood G, Ratcliffe P, Epstein R, Pijper A, Svec JG, \"Electroglottographic study of seven semi-occluded exercises: LaxVox, straw, lip-trill, tongue-trill, humming, hand-over-mouth, and tongue-trill combined with hand-over-mouth\", Journal of Voice 2014"}, "url": "https://pubmed.ncbi.nlm.nih.gov/24560003/"},
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": {"en": "A lip trill is a \"brr\" like a motorboat: loose lips fluttering on easy breath. It's one of the gentlest ways to wake your voice up."},
                            "steps": [
                                {"title": {"en": "Loose lips"}, "detail": {"en": "A fingertip at each corner of your mouth helps"}},
                                {"title": {"en": "Easy breath"}, "detail": {"en": "Never forced, just a steady flow"}},
                                {"title": {"en": "Stop if it strains"}, "detail": {"en": "Tightens, tickles or hurts: rest. Don't sing when hoarse or ill"}}
                            ],
                            "reviewed": false
                        },
                        {
                            "kind": "wave",
                            "text": {"en": "Ride the roller coaster on one bubble: up, down, up again. Can't trill yet? Hum or slide on \"oo\" instead: the app follows whatever easy sound you make."},
                            "exercise": {
                                "tempo": 60,
                                "lead": 2,
                                "step": 0,
                                "lyric": "brr",
                                "combo": false,
                                "score": "unbroken",
                                "target": [
                                    {
                                        "seconds": 6,
                                        "kind": "path",
                                        "band": 200,
                                        "points": [
                                            [0, 0],
                                            [1.5, 5],
                                            [3, 0],
                                            [4.5, 7],
                                            [6, 0]
                                        ]
                                    }
                                ],
                                "trill": true,
                                "generous": true,
                                "keep": "humming.first-coaster"
                            },
                            "measures": {"en": "Scored on following the ribbon in one unbroken sound, never on how high or how long. The app can't tell a bubble from a hum, so either counts."}
                        },
                        {
                            "kind": "selfcheck",
                            "text": {"en": "One more bubble, then listen back."},
                            "exercise": {
                                "tempo": 60,
                                "lead": 2,
                                "model": {
                                    "notes": [
                                        {"beat": 0, "length": 2, "step": 0, "lyric": "brr"},
                                        {"beat": 2, "length": 2, "step": 5, "lyric": "brr"},
                                        {"beat": 4, "length": 2, "step": 0, "lyric": "brr"}
                                    ]
                                },
                                "questions": [
                                    {"en": "Did the bubble keep going?"},
                                    {"en": "If it stopped, did you hold your breath or tighten your jaw?"}
                                ]
                            }
                        }
                    ]
                },
                {
                    "id": "hum-1-bubble",
                    "title": {"en": "Keep it bubbling"},
                    "fact": {"id": "hum-brass-lip-buzz", "text": {"en": "Brass players learn to buzz with the lips alone: close the mouth, pull the lips back in a smile, and blow. Depending on lip tension and breath, it comes out anywhere from a low raspberry to a high note."}, "source": {"en": "UNSW Music Acoustics, \"Brass instrument (lip reed) acoustics: an introduction\""}, "url": "https://newt.phys.unsw.edu.au/jw/brassacoustics.html"},
                    "steps": [
                        {
                            "kind": "wave",
                            "text": {"en": "A gentler hill on one bubble. Can't trill yet? Hum or slide on \"oo\" instead: the app follows whatever easy sound you make."},
                            "exercise": {
                                "tempo": 60,
                                "lead": 2,
                                "step": 0,
                                "lyric": "brr",
                                "combo": false,
                                "score": "unbroken",
                                "target": [
                                    {
                                        "seconds": 4,
                                        "kind": "path",
                                        "band": 150,
                                        "points": [
                                            [0, 0],
                                            [2, 4],
                                            [4, 0]
                                        ]
                                    }
                                ],
                                "trill": true
                            },
                            "measures": {"en": "Scored on following the ribbon in one unbroken sound, never on how high or how long. The app can't tell a bubble from a hum, so either counts."}
                        },
                        {
                            "kind": "wave",
                            "text": {"en": "The same, a little longer, on one breath. Can't trill yet? Hum or slide on \"oo\" instead: the app follows whatever easy sound you make."},
                            "exercise": {
                                "tempo": 60,
                                "lead": 2,
                                "step": 0,
                                "lyric": "brr",
                                "combo": false,
                                "score": "unbroken",
                                "target": [
                                    {
                                        "seconds": 6,
                                        "kind": "path",
                                        "band": 150,
                                        "points": [
                                            [0, 0],
                                            [3, 5],
                                            [6, 0]
                                        ]
                                    }
                                ],
                                "trill": true
                            },
                            "measures": {"en": "Scored on following the ribbon in one unbroken sound, never on how high or how long. The app can't tell a bubble from a hum, so either counts."}
                        }
                    ]
                },
                {
                    "id": "hum-1-tune",
                    "title": {"en": "Trill on a tune"},
                    "fact": {"id": "hum-trill-widens-range", "text": {"en": "In a 2020 study, 25 women did 3 minutes of lip trills. Straight after, their singing pitch range was wider on average, and their loudest notes rose by about 3 decibels."}, "source": {"en": "Brockmann-Bauser M, Balandat B, Bohlender JE, \"Immediate Lip Trill Effects on the Standard Diagnostic Measures Voice Range Profile, Jitter, Maximum Phonation Time, and Dysphonia Severity Index\", Journal of Voice 2020"}, "url": "https://pubmed.ncbi.nlm.nih.gov/31196690/"},
                    "steps": [
                        {
                            "kind": "play",
                            "text": {"en": "Five notes up and back on a trill, heard then sung. Can't trill yet? Hum or slide on \"oo\" instead: the app follows whatever easy sound you make."},
                            "exercise": {
                                "tempo": 76,
                                "turn": true,
                                "notes": [
                                    {"beat": 0, "length": 1, "step": 0, "lyric": "brr"},
                                    {"beat": 1, "length": 1, "step": 2, "lyric": "brr"},
                                    {"beat": 2, "length": 1, "step": 4, "lyric": "brr"},
                                    {"beat": 3, "length": 1, "step": 5, "lyric": "brr"},
                                    {"beat": 4, "length": 1, "step": 7, "lyric": "brr"},
                                    {"beat": 5, "length": 1, "step": 5, "lyric": "brr"},
                                    {"beat": 6, "length": 1, "step": 4, "lyric": "brr"},
                                    {"beat": 7, "length": 1, "step": 2, "lyric": "brr"},
                                    {"beat": 8, "length": 2, "step": 0, "lyric": "brr"}
                                ],
                                "trill": true
                            },
                            "measures": {"en": "Scored on the notes."}
                        },
                        {
                            "kind": "selfcheck",
                            "text": {"en": "Trill the top note once more and listen back."},
                            "exercise": {
                                "tempo": 60,
                                "lead": 2,
                                "model": {
                                    "notes": [{"beat": 0, "length": 3, "step": 7, "lyric": "brr"}]
                                },
                                "questions": [{"en": "Did your jaw stay loose?"}, {"en": "Did the bubble keep going on the high note?"}]
                            }
                        }
                    ]
                },
                {
                    "id": "hum-1-challenge",
                    "title": {"en": "The big dipper"},
                    "challenge": true,
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": {"en": "A longer roller coaster, up to about an octave and back, on one bubble."},
                            "steps": [
                                {"title": {"en": "Breathe first"}, "detail": {"en": "Then the whole ride"}},
                                {"title": {"en": "Light at the top"}, "detail": {"en": "Easy, never forced; stop if anything tightens or hurts"}}
                            ],
                            "reviewed": false
                        },
                        {
                            "kind": "wave",
                            "text": {"en": "The big dipper, on one bubble. Can't trill yet? Hum or slide on \"oo\" instead: the app follows whatever easy sound you make."},
                            "exercise": {
                                "tempo": 60,
                                "lead": 2,
                                "step": 0,
                                "lyric": "brr",
                                "combo": false,
                                "score": "unbroken",
                                "target": [
                                    {
                                        "seconds": 8,
                                        "kind": "path",
                                        "band": 200,
                                        "points": [
                                            [0, 0],
                                            [2, 7],
                                            [3.5, 2],
                                            [5.5, 12],
                                            [8, 0]
                                        ]
                                    }
                                ],
                                "trill": true
                            },
                            "measures": {"en": "Scored on following the ribbon in one unbroken sound, never on how high or how long. The app can't tell a bubble from a hum, so either counts."}
                        }
                    ]
                }
            ]
        },
        {
            "id": "hum-ng",
            "title": {"en": "The \"ng\" siren"},
            "colour": 3,
            "lessons": [
                {
                    "id": "hum-2-ng",
                    "title": {"en": "Ng"},
                    "fact": {"id": "hum-soft-palate-gate", "text": {"en": "Your soft palate, the soft back part of the roof of your mouth, is the gate to your nose. For \"m\" and \"ng\" it lowers, so air flows out through your nose."}, "source": {"en": "University of Manitoba Linguistics (Kevin Russell), \"Anatomy: Soft palate\""}, "url": "https://home.cc.umanitoba.ca/~krussll/phonetics/anatomy/soft-palate.html"},
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": {"en": "\"Ng\" is the sound at the end of \"sing\": the back of your tongue up, your jaw easy, the sound coming out through your nose."},
                            "steps": [
                                {"title": {"en": "Say \"sing\""}, "detail": {"en": "And keep the end going"}},
                                {"title": {"en": "Jaw easy"}, "detail": {"en": "Teeth a little apart"}},
                                {"title": {"en": "Quiet"}, "detail": {"en": "A gentle, buzzy hum; stop if anything tightens or hurts"}}
                            ],
                            "reviewed": false
                        },
                        {
                            "kind": "wave",
                            "text": {"en": "Hold an easy \"ng\"."},
                            "exercise": {
                                "tempo": 60,
                                "lead": 2,
                                "step": 0,
                                "lyric": "ng",
                                "combo": false,
                                "target": [{"seconds": 4, "kind": "straight"}]
                            },
                            "measures": {"en": "Scored on holding the note steady."}
                        },
                        {
                            "kind": "wave",
                            "text": {"en": "A small siren on \"ng\", up and back."},
                            "exercise": {
                                "tempo": 60,
                                "lead": 2,
                                "step": 0,
                                "lyric": "ng",
                                "combo": false,
                                "target": [
                                    {
                                        "seconds": 4,
                                        "kind": "path",
                                        "band": 150,
                                        "points": [
                                            [0, 0],
                                            [2, 4],
                                            [4, 0]
                                        ]
                                    }
                                ]
                            },
                            "measures": {"en": "Scored on following the ribbon."}
                        }
                    ]
                },
                {
                    "id": "hum-2-bigger",
                    "title": {"en": "Bigger sirens"},
                    "fact": {"id": "hum-siren-named-1819", "text": {"en": "The siren got its name in 1819 from Charles Cagniard de la Tour, who built an improved one. It could sound even under water, he wrote, so he named it after the singing Sirens of Greek myth."}, "source": {"en": "Cagniard de la Tour, \"Sur la Sirène, nouvelle machine d'acoustique...\", Annales de chimie et de physique 12 (1819), p. 171, quoted and translated in Wikipedia, \"Siren (alarm)\""}, "url": "https://en.wikipedia.org/wiki/Siren_(alarm)"},
                    "steps": [
                        {
                            "kind": "wave",
                            "text": {"en": "Up a sixth and back on \"ng\"."},
                            "exercise": {
                                "tempo": 60,
                                "lead": 2,
                                "step": 0,
                                "lyric": "ng",
                                "combo": false,
                                "target": [
                                    {
                                        "seconds": 5,
                                        "kind": "path",
                                        "band": 150,
                                        "points": [
                                            [0, 0],
                                            [2.5, 9],
                                            [5, 0]
                                        ]
                                    }
                                ]
                            },
                            "measures": {"en": "Scored on following the ribbon."}
                        },
                        {
                            "kind": "wave",
                            "text": {"en": "Up an octave and back, easy at the top."},
                            "exercise": {
                                "tempo": 60,
                                "lead": 2,
                                "step": 0,
                                "lyric": "ng",
                                "combo": false,
                                "target": [
                                    {
                                        "seconds": 6,
                                        "kind": "path",
                                        "band": 150,
                                        "points": [
                                            [0, 0],
                                            [3, 12],
                                            [6, 0]
                                        ]
                                    }
                                ]
                            },
                            "measures": {"en": "Scored on following the ribbon."}
                        }
                    ]
                },
                {
                    "id": "hum-2-open",
                    "title": {"en": "Ng to ah"},
                    "fact": {"id": "hum-maori-nga-breathe", "text": {"en": "In Māori, ng is one sound, and a word can begin with it: \"ngā\", ng opening into a long \"ah\", can mean \"to breathe\". English only lets ng end a syllable, as in sing, never start a word."}, "source": {"en": "Victoria University of Wellington, \"Te reo Māori pronunciation guide\"; Te Aka Māori Dictionary, \"ngā\"; World Atlas of Language Structures, chapter 9, \"The Velar Nasal\""}, "url": "https://www.wgtn.ac.nz/maori-hub/ako/te-reo-at-university/te-reo-maori-pronunciation-guide"},
                    "steps": [
                        {
                            "kind": "play",
                            "text": {"en": "A held \"ng\" opening into \"ah\" on the same note, heard then sung."},
                            "exercise": {
                                "tempo": 76,
                                "turn": true,
                                "notes": [
                                    {"beat": 0, "length": 2, "step": 0, "lyric": "ng"},
                                    {"beat": 2, "length": 2, "step": 0, "lyric": "ah"},
                                    {"beat": 4, "length": 2, "step": 4, "lyric": "ng"},
                                    {"beat": 6, "length": 2, "step": 4, "lyric": "ah"}
                                ]
                            },
                            "measures": {"en": "Scored on the notes."}
                        },
                        {
                            "kind": "selfcheck",
                            "text": {"en": "Once more, then listen back."},
                            "exercise": {
                                "tempo": 60,
                                "lead": 2,
                                "model": {
                                    "notes": [
                                        {"beat": 0, "length": 2, "step": 0, "lyric": "ng"},
                                        {"beat": 2, "length": 2, "step": 0, "lyric": "ah"}
                                    ]
                                },
                                "questions": [{"en": "Did the \"ah\" keep the buzz of the \"ng\"?"}]
                            }
                        }
                    ]
                },
                {
                    "id": "hum-2-challenge",
                    "title": {"en": "Siren loops"},
                    "challenge": true,
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": {"en": "Two loops up and over on \"ng\", easy all the way."},
                            "steps": [
                                {"title": {"en": "Light at the top"}, "detail": {"en": "Easy, never forced; stop if anything tightens or hurts"}},
                                {"title": {"en": "One breath each"}, "detail": {"en": "Or a quick one between"}}
                            ],
                            "reviewed": false
                        },
                        {
                            "kind": "wave",
                            "text": {"en": "Two siren loops on \"ng\"."},
                            "exercise": {
                                "tempo": 60,
                                "lead": 2,
                                "step": 0,
                                "lyric": "ng",
                                "combo": false,
                                "target": [
                                    {
                                        "seconds": 6,
                                        "kind": "path",
                                        "band": 150,
                                        "points": [
                                            [0, 0],
                                            [1.5, 7],
                                            [3, 0],
                                            [4.5, 7],
                                            [6, 0]
                                        ]
                                    }
                                ],
                                "generous": true
                            },
                            "measures": {"en": "Scored on following the ribbon."}
                        }
                    ]
                }
            ]
        },
        {
            "id": "hum-hum",
            "title": {"en": "Resonant humming"},
            "colour": 5,
            "lessons": [
                {
                    "id": "hum-3-buzz",
                    "title": {"en": "A buzzing hum"},
                    "fact": {"id": "hum-face-buzz", "text": {"en": "The buzz you feel in your face on an easy, ringing tone isn't sound echoing in your sinuses, an acoustic study argued. It's a sign your voice is turning breath into sound well."}, "source": {"en": "Titze IR, \"Acoustic interpretation of resonant voice\", Journal of Voice 2001"}, "url": "https://pubmed.ncbi.nlm.nih.gov/11792028/"},
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": {"en": "Lips together, teeth apart, and hum. Feel for a buzz on your lips and around your nose: it's a good sign."},
                            "steps": [
                                {"title": {"en": "Lips together"}, "detail": {"en": "Teeth apart"}},
                                {"title": {"en": "Feel the buzz"}, "detail": {"en": "Lips and nose"}},
                                {"title": {"en": "Easy"}, "detail": {"en": "Talking volume or quieter; stop if anything tightens or hurts"}}
                            ],
                            "reviewed": false
                        },
                        {
                            "kind": "wave",
                            "text": {"en": "Hold an easy hum."},
                            "exercise": {
                                "tempo": 60,
                                "lead": 2,
                                "step": 0,
                                "lyric": "mm",
                                "combo": false,
                                "target": [{"seconds": 4, "kind": "straight"}]
                            },
                            "measures": {"en": "Scored on holding the note steady."}
                        },
                        {
                            "kind": "selfcheck",
                            "text": {"en": "Hum once more and listen back."},
                            "exercise": {
                                "tempo": 60,
                                "lead": 2,
                                "model": {
                                    "notes": [{"beat": 0, "length": 4, "step": 0, "lyric": "mm"}]
                                },
                                "questions": [{"en": "Did you feel a buzz on your lips?"}]
                            }
                        }
                    ]
                },
                {
                    "id": "hum-3-tune",
                    "title": {"en": "Hum a tune"},
                    "fact": {"id": "hum-nitric-oxide", "text": {"en": "Your sinuses make a gas called nitric oxide. In a 2002 study of 10 people, humming raised the amount in air breathed out through the nose fifteenfold over quiet breathing out."}, "source": {"en": "Weitzberg E, Lundberg JO, \"Humming greatly increases nasal nitric oxide\", American Journal of Respiratory and Critical Care Medicine 2002"}, "url": "https://pubmed.ncbi.nlm.nih.gov/12119224/"},
                    "steps": [
                        {
                            "kind": "play",
                            "text": {"en": "A short tune, hummed, heard then sung."},
                            "exercise": {
                                "tempo": 76,
                                "turn": true,
                                "notes": [
                                    {"beat": 0, "length": 1, "step": 0, "lyric": "mm"},
                                    {"beat": 1, "length": 1, "step": 2, "lyric": "mm"},
                                    {"beat": 2, "length": 1, "step": 4, "lyric": "mm"},
                                    {"beat": 3, "length": 1, "step": 5, "lyric": "mm"},
                                    {"beat": 4, "length": 1, "step": 4, "lyric": "mm"},
                                    {"beat": 5, "length": 1, "step": 2, "lyric": "mm"},
                                    {"beat": 6, "length": 2, "step": 0, "lyric": "mm"}
                                ]
                            },
                            "measures": {"en": "Scored on the notes."}
                        }
                    ]
                },
                {
                    "id": "hum-3-open",
                    "title": {"en": "Hum to open"},
                    "fact": {"id": "hum-jakobson-mama", "text": {"en": "Open a hum to \"ah\" and you get \"ma\". The linguist Roman Jakobson suggested that's where \"mama\" comes from: a nursing baby, mouth full, can only murmur through its nose, and once its mouth is free, opens the murmur into a vowel."}, "source": {"en": "Roman Jakobson, \"Why 'mama' and 'papa'?\", Selected Writings I: Phonological Studies (Mouton, 1962), pp. 542-543"}, "url": "https://archive.org/details/selectedwritings01jako"},
                    "steps": [
                        {
                            "kind": "play",
                            "text": {"en": "\"Mm\" opening into \"ah\" on one note, heard then sung."},
                            "exercise": {
                                "tempo": 76,
                                "turn": true,
                                "notes": [
                                    {"beat": 0, "length": 2, "step": 0, "lyric": "mm"},
                                    {"beat": 2, "length": 2, "step": 0, "lyric": "ah"}
                                ]
                            },
                            "measures": {"en": "Scored on the notes."}
                        },
                        {
                            "kind": "play",
                            "text": {"en": "Now on three notes going up."},
                            "exercise": {
                                "tempo": 76,
                                "turn": true,
                                "notes": [
                                    {"beat": 0, "length": 1, "step": 0, "lyric": "mm"},
                                    {"beat": 1, "length": 1, "step": 0, "lyric": "ah"},
                                    {"beat": 2, "length": 1, "step": 2, "lyric": "mm"},
                                    {"beat": 3, "length": 1, "step": 2, "lyric": "ah"},
                                    {"beat": 4, "length": 1, "step": 4, "lyric": "mm"},
                                    {"beat": 5, "length": 1, "step": 4, "lyric": "ah"}
                                ]
                            },
                            "measures": {"en": "Scored on the notes."}
                        }
                    ]
                },
                {
                    "id": "hum-3-challenge",
                    "title": {"en": "Hum a line"},
                    "challenge": true,
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": {"en": "A longer hummed line. Keep the buzz all the way through."},
                            "steps": [
                                {"title": {"en": "Lips together"}, "detail": {"en": "Teeth apart"}},
                                {"title": {"en": "Easy"}, "detail": {"en": "Never forced; stop if anything tightens or hurts"}}
                            ],
                            "reviewed": false
                        },
                        {
                            "kind": "play",
                            "text": {"en": "Hear it, then hum it back."},
                            "exercise": {
                                "tempo": 76,
                                "turn": true,
                                "notes": [
                                    {"beat": 0, "length": 1, "step": 0, "lyric": "mm"},
                                    {"beat": 1, "length": 1, "step": 2, "lyric": "mm"},
                                    {"beat": 2, "length": 1, "step": 4, "lyric": "mm"},
                                    {"beat": 3, "length": 1, "step": 7, "lyric": "mm"},
                                    {"beat": 4, "length": 1, "step": 5, "lyric": "mm"},
                                    {"beat": 5, "length": 1, "step": 4, "lyric": "mm"},
                                    {"beat": 6, "length": 1, "step": 2, "lyric": "mm"},
                                    {"beat": 7, "length": 1, "step": 4, "lyric": "mm"},
                                    {"beat": 8, "length": 1, "step": 2, "lyric": "mm"},
                                    {"beat": 9, "length": 2, "step": 0, "lyric": "mm"}
                                ]
                            },
                            "measures": {"en": "Scored on the notes."}
                        }
                    ]
                }
            ]
        },
        {
            "id": "hum-song",
            "title": {"en": "From warm-up to song"},
            "colour": 2,
            "lessons": [
                {
                    "id": "hum-4-trill-line",
                    "title": {"en": "Trill into a line"},
                    "fact": {"id": "hum-kele-trill-word", "text": {"en": "In Kele, spoken on Manus Island in Papua New Guinea, a lip trill can be part of a word: the word for face starts with m, then a lip trill, then \"oo\"."}, "source": {"en": "UCLA Phonetics Lab, Ladefoged, Vowels and Consonants (companion site), \"Kele and Titan trills\"; Wikipedia, \"Kele language (New Guinea)\" for Manus Island"}, "url": "https://phonetics.ucla.edu/vowels/chapter13/kele.html"},
                    "steps": [
                        {
                            "kind": "play",
                            "text": {"en": "A line on a trill, heard then sung. Can't trill yet? Hum or slide on \"oo\" instead: the app follows whatever easy sound you make."},
                            "exercise": {
                                "tempo": 76,
