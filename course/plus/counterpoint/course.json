                {
                    "id": "cp-1-hear",
                    "title": {"en": "Which voice moved?"},
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": {"en": "Your ear can follow two voices at once. Listen for which one moves."},
                            "steps": [
                                {"title": {"en": "Two voices"}, "detail": {"en": "One high, one low, at the same time"}},
                                {"title": {"en": "Find the one that moves"}, "detail": {"en": "The other holds still, or sings its own tune"}},
                                {"title": {"en": "Hear it as often as you like"}, "detail": {"en": "Then choose"}}
                            ],
                            "visual": "harmony",
                            "reviewed": false
                        },
