                {
                    "id": "pop-1-fall",
                    "title": { "en": "The fall-off" },
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": {
                                "en": "A fall-off lets the end of a note drop away. Let the pitch go and keep the breath steady, never a collapse into a creak."
                            },
                            "steps": [
                                { "title": { "en": "Hold, then let go" }, "detail": { "en": "The note first, the fall at its end" } },
                                { "title": { "en": "Short, then longer" }, "detail": { "en": "A little drop, then a bigger one" } },
                                { "title": { "en": "Keep the breath" }, "detail": { "en": "The pitch falls, the breath doesn't" } }
                            ],
                            "visual": "phrase",
                            "reviewed": false,
                            "listen": {
                                "tempo": 72,
                                "notes": [
                                    { "beat": 0, "length": 3, "step": 2, "lyric": "oo", "style": "fall" },
                                    { "beat": 4, "length": 3, "step": 4, "lyric": "oo", "style": "fall" }
                                ],
                                "turn": false
                            }
                        },
                        {
