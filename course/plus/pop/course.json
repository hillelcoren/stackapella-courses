                {
                    "id": "pop-1-scoop",
                    "title": { "en": "The scoop" },
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": {
                                "en": "A scoop slides up into a note from a little below, on purpose. Done well it sounds meant, not missed."
                            },
                            "steps": [
                                { "title": { "en": "From below" }, "detail": { "en": "A semitone to a third under the note" } },
                                { "title": { "en": "Quick or lazy" }, "detail": { "en": "A flick, or a slow, easy rise" } },
                                { "title": { "en": "Land on the note" }, "detail": { "en": "Then hold it steady" } }
                            ],
                            "visual": "phrase",
                            "reviewed": false,
                            "listen": {
                                "tempo": 72,
                                "notes": [
                                    { "beat": 0, "length": 2, "step": 0, "lyric": "oo", "style": "scoop" },
                                    { "beat": 3, "length": 2, "step": 2, "lyric": "oo", "style": "scoop" }
                                ],
                                "turn": false
                            }
                        },
                        {
                            "kind": "choose",
                            "text": { "en": "Listen to both, then choose." },
                            "exercise": {
                                "tempo": 72,
                                "rounds": [
                                    {
                                        "prompt": { "en": "Which one scooped?" },
                                        "clips": [
                                            { "notes": [{ "beat": 0, "length": 2, "step": 0, "lyric": "oo" }] },
                                            { "notes": [{ "beat": 0, "length": 2, "step": 0, "lyric": "oo", "style": "scoop" }] }
                                        ],
                                        "answer": 1,
                                        "why": { "en": "B slid up into the note from below. A started right on it." }
                                    },
                                    {
                                        "prompt": { "en": "Which one scooped?" },
                                        "clips": [
                                            { "notes": [{ "beat": 0, "length": 2, "step": 2, "lyric": "oo", "style": "scoop" }] },
                                            { "notes": [{ "beat": 0, "length": 2, "step": 2, "lyric": "oo" }] }
                                        ],
                                        "answer": 0,
                                        "why": { "en": "A rose into its note; B was straight from the start." }
                                    }
                                ]
                            }
                        },
                        {
                            "kind": "play",
                            "text": { "en": "Listen, then sing them back, each with a quick scoop." },
                            "exercise": {
                                "tempo": 72,
                                "notes": [
                                    { "beat": 0, "length": 2, "step": 0, "lyric": "oo", "style": "scoop" },
                                    { "beat": 3, "length": 2, "step": 2, "lyric": "oo", "style": "scoop" },
                                    { "beat": 6, "length": 2, "step": 4, "lyric": "oo", "style": "scoop" }
                                ],
                                "turn": true,
                                "score": "styled"
                            }
                        },
                        {
                            "kind": "play",
                            "text": { "en": "Now lazy scoops: a slower, easy rise into each." },
                            "exercise": {
                                "tempo": 72,
                                "notes": [
                                    { "beat": 0, "length": 2, "step": 0, "lyric": "oo", "style": "scoop" },
                                    { "beat": 3, "length": 2, "step": 2, "lyric": "oo", "style": "scoop" },
                                    { "beat": 6, "length": 2, "step": 4, "lyric": "oo", "style": "scoop" }
                                ],
                                "turn": true,
                                "score": "styled",
                                "window": 0.5
                            },
                            "measures": {
                                "en": "Your stars are for the scoops and the notes they land on. Did they sound meant, not missed? Next: the fall-off."
                            }
                        }
                    ]
