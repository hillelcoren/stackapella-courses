    "title": {
        "en": "Breath and stamina"
    },
    "units": [
        {
            "id": "br-one-breath",
            "title": {
                "en": "One easy breath"
            },
            "colour": 4,
            "lessons": [
                {
                    "id": "br-1-long",
                    "title": {
                        "en": "The long note"
                    },
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": {
                                "en": "A long note isn't about big lungs. It's letting the air out slowly, and stopping while it's still easy."
                            },
                            "steps": [
                                {
                                    "title": {
                                        "en": "Warm up"
                                    },
                                    "detail": {
                                        "en": "Hum a few slow slides, low to high and back"
                                    }
                                },
                                {
                                    "title": {
                                        "en": "Breathe in low"
                                    },
                                    "detail": {
                                        "en": "Belly, sides and back widen; shoulders stay down"
                                    }
                                },
                                {
                                    "title": {
                                        "en": "Stop while it's easy"
                                    },
                                    "detail": {
                                        "en": "Never squeeze out the last drop"
                                    }
                                }
                            ],
                            "listen": {
                                "tempo": 60,
                                "notes": [
                                    {
                                        "beat": 1,
                                        "length": 6,
                                        "step": 0,
                                        "lyric": "oo"
                                    }
                                ],
                                "turn": false,
                                "drone": {
                                    "step": 0
                                }
                            },
                            "visual": "breath",
                            "reviewed": false
                        },
                        {
                            "kind": "breathhold",
                            "text": {
                                "en": "Hold \"oo\" over the drone as long as it's easy. No goal: this first hold is your own starting point."
                            },
                            "exercise": {
                                "step": 0,
                                "lyric": "oo",
                                "drone": {
                                    "step": 0
                                },
                                "baseline": true,
                                "generous": true
                            }
                        },
                        {
                            "kind": "breathhold",
                            "text": {
                                "en": "Again, with your first try marked. Breathe low, let the air out slowly, and stop while it's still steady."
                            },
                            "exercise": {
                                "step": 0,
                                "lyric": "oo",
                                "drone": {
                                    "step": 0
                                },
                                "goal": {
                                    "plus": 0
                                },
                                "compare": {
                                    "step": 1
                                },
                                "generous": true
                            },
                            "measures": {
                                "en": "Your stars are for how your note ended (steady, because you stopped while it was easy), how steady it was, and reaching your own goal. Going past it earns nothing more."
                            }
                        }
                    ]
                },
                {
                    "id": "br-1-wide",
                    "title": {
                        "en": "Keep the ribs wide"
                    },
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": {
                                "en": "Good support slows your ribs from collapsing. Singers call it appoggio: leaning."
                            },
                            "steps": [
                                {
                                    "title": {
                                        "en": "Hands on your lower ribs"
                                    },
                                    "detail": {
                                        "en": "At your sides, thumbs to the back"
                                    }
                                },
                                {
                                    "title": {
                                        "en": "Breathe in"
                                    },
                                    "detail": {
                                        "en": "Feel the ribs widen; shoulders stay down"
                                    }
                                },
                                {
                                    "title": {
                                        "en": "Keep them wide"
                                    },
                                    "detail": {
                                        "en": "As you sing, let them close slowly"
                                    }
                                }
                            ],
                            "listen": {
                                "tempo": 60,
                                "notes": [
                                    {
                                        "beat": 1,
                                        "length": 6,
                                        "step": 0,
                                        "lyric": "vv"
                                    }
                                ],
                                "turn": false,
                                "drone": {
                                    "step": 0
                                }
                            },
                            "visual": "breath",
                            "reviewed": false
                        },
                        {
                            "kind": "breathhold",
                            "text": {
                                "en": "Try a big breath (not your biggest) and sing at once, without holding it. Then a normal breath. Which felt easier?"
                            },
                            "exercise": {
                                "step": 0,
                                "lyric": "vv",
                                "drone": {
                                    "step": 0
                                }
                            }
                        },
                        {
                            "kind": "breathhold",
                            "text": {
                                "en": "Hands on your ribs. Hold \"vv\" to your goal, keeping the ribs wide. Did your shoulders stay down?"
                            },
                            "exercise": {
                                "step": 0,
                                "lyric": "vv",
                                "drone": {
                                    "step": 0
                                },
                                "goal": {
                                    "plus": 0
                                },
                                "compare": "baseline"
                            },
                            "measures": {
                                "en": "Your stars are for how the hold ended, how steady it was, and reaching your goal. Whether your ribs stayed wide is yours to check: we can't see it."
                            }
                        }
                    ]
                },
