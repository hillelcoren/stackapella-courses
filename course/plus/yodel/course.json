                {
                    "id": "yodel-1-two",
                    "title": { "en": "Two voices" },
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": {
                                "en": "Your voice has two sounds: chest voice, low and speaking-like, and head voice, high, light and hooty. A yodel flips between them."
                            },
                            "steps": [
                                { "title": { "en": "Warm up first" }, "detail": { "en": "A lip trill or a quiet siren, up and down" } },
                                { "title": { "en": "\"ho\" below your flip" }, "detail": { "en": "Chest buzzes" } },
                                { "title": { "en": "\"hoo\" above it" }, "detail": { "en": "Head floats, light and quiet" } }
                            ],
                            "visual": "steady",
                            "reviewed": false,
                            "listen": {
                                "tempo": 60,
                                "notes": [
                                    { "beat": 0, "length": 3, "step": -7, "lyric": "ho" },
