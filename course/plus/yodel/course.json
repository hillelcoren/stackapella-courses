                    "strictness": "relaxed",
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": {
                                "en": "Herders called across valleys with a voice that flips, and the flip is already in yours. Listen for the jump: yours will do this too, and that's the point."
                            },
                            "steps": [
                                { "title": { "en": "Warm up first" }, "detail": { "en": "A lip trill or a quiet siren, up and down" } },
                                { "title": { "en": "A light flick" }, "detail": { "en": "Never a crack, never a hard catch: medium volume" } },
                                { "title": { "en": "Stop if it strains" }, "detail": { "en": "Tightens, tickles or hurts: rest" } }
                            ],
