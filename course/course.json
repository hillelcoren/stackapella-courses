     "title": {
      "en": "Small jumps"
     },
     "steps": [
      {
       "kind": "learn",
       "text": {
        "en": "A jump skips a note. Hear the landing note in your head before you sing it."
       }
      },
      {
       "kind": "play",
       "text": {
        "en": "Listen, then sing the jumps."
       },
       "exercise": {
