{
 "id": "stackapella-course",
 "version": 1,
 "reviewed": false,
 "title": {
  "en": "Learn to sing harmony"
 },
 "units": [
  {
   "id": "find-your-voice",
   "title": {
    "en": "Find your voice"
   },
   "colour": 1,
   "lessons": [
    {
     "id": "1-comfortable",
     "title": {
      "en": "Your comfortable note"
     },
     "steps": [
      {
       "kind": "learn",
       "text": {
        "en": "Every voice has a note that feels easy, not too high and not too low. Hum one, then sing it on \"oo\". There's no wrong note."
       }
      },
      {
       "kind": "home",
       "text": {
        "en": "Sing any note that feels easy, and hold it for a few seconds."
       }
      }
     ],
     "findsHome": true
    },
    {
     "id": "1-match",
     "title": {
      "en": "Match a note"
     },
     "steps": [
      {
       "kind": "learn",
       "text": {
        "en": "Now you'll hear a note. Listen, then sing the same note back. When you match it, it lights up."
       },
       "listen": {
        "tempo": 72,
        "notes": [
         {
          "beat": 0,
          "length": 3,
          "step": 0,
          "lyric": "oo"
         }
        ],
        "turn": false
       }
      },
      {
       "kind": "try",
       "text": {
        "en": "Sing along with the note."
       },
       "exercise": {
        "tempo": 72,
        "notes": [
         {
          "beat": 0,
          "length": 4,
          "step": 0,
          "lyric": "oo"
         }
        ],
        "turn": false
       }
      },
      {
       "kind": "play",
       "text": {
        "en": "Listen, then sing it back. One star for trying, more for matching."
       },
       "exercise": {
        "tempo": 72,
        "notes": [
         {
          "beat": 0,
          "length": 2,
          "step": 0,
          "lyric": "oo"
         },
         {
          "beat": 3,
          "length": 2,
          "step": 2,
          "lyric": "oo"
         },
         {
          "beat": 6,
          "length": 2,
          "step": -2,
          "lyric": "oo"
         }
        ],
        "turn": true
       }
      }
     ]
    },
    {
     "id": "1-high-low",
     "title": {
      "en": "Higher and lower"
     },
     "steps": [
      {
       "kind": "learn",
       "text": {
        "en": "A note can sit above or below your easy note. Listen for which way it goes before you sing."
       }
      },
      {
       "kind": "play",
       "text": {
        "en": "Listen, then sing each note back."
       },
       "exercise": {
        "tempo": 72,
        "notes": [
         {
          "beat": 0,
          "length": 2,
          "step": 0,
          "lyric": "oo"
         },
         {
          "beat": 3,
          "length": 2,
          "step": 4,
          "lyric": "oo"
         },
         {
          "beat": 6,
          "length": 2,
          "step": 0,
          "lyric": "oo"
         },
         {
          "beat": 9,
          "length": 2,
          "step": -3,
          "lyric": "oo"
         }
        ],
        "turn": true
       }
      }
     ]
    },
    {
     "id": "1-breath",
     "title": {
      "en": "Breathing for singing"
     },
     "steps": [
      {
       "kind": "learn",
       "text": {
        "en": "Breathe in low, as if filling your belly, shoulders still. Then let the air out slowly on \"sss\" for as long as is comfortable. Breath that's steady gives notes that are steady."
       }
      },
      {
       "kind": "play",
       "text": {
        "en": "Breathe in, then hold this long note on \"oo\"."
       },
       "exercise": {
        "tempo": 60,
        "notes": [
         {
          "beat": 0,
          "length": 6,
          "step": 0,
          "lyric": "oo"
         }
        ],
        "turn": true
       }
      }
     ]
    },
    {
     "id": "1-challenge",
     "title": {
      "en": "Sing back five notes"
     },
     "steps": [
      {
       "kind": "play",
       "text": {
        "en": "The unit's challenge: listen, then sing all five notes back."
       },
       "exercise": {
        "tempo": 66,
        "notes": [
         {
          "beat": 0,
          "length": 1,
          "step": 0,
          "lyric": "oo"
         },
         {
          "beat": 1,
          "length": 1,
          "step": 2,
          "lyric": "oo"
         },
         {
          "beat": 2,
          "length": 1,
          "step": 4,
          "lyric": "oo"
         },
         {
          "beat": 3,
          "length": 1,
          "step": 2,
          "lyric": "oo"
         },
         {
          "beat": 4,
          "length": 2,
          "step": 0,
          "lyric": "oo"
         }
        ],
        "turn": true
       }
      }
     ],
     "challenge": true
    }
   ]
  },
  {
   "id": "steady-notes",
   "title": {
    "en": "Steady notes"
   },
   "colour": 2,
   "lessons": [
    {
     "id": "2-hold",
     "title": {
      "en": "Hold a note"
     },
     "steps": [
      {
       "kind": "learn",
       "text": {
        "en": "A steady note doesn't wobble or slide. Breathe, start the note cleanly, and keep the air flowing evenly."
       }
      },
      {
       "kind": "play",
       "text": {
        "en": "Listen, then hold the note for four beats."
       },
       "exercise": {
        "tempo": 72,
        "notes": [
         {
          "beat": 0,
          "length": 4,
          "step": 0,
          "lyric": "oo"
         }
        ],
        "turn": true
       }
      }
     ]
    },
    {
     "id": "2-drone",
     "title": {
      "en": "Against a drone"
     },
     "steps": [
      {
       "kind": "learn",
       "text": {
        "en": "A drone is a note that keeps sounding. Singing against one is how choirs tune: you'll hear the two notes settle together when you're right."
       },
       "listen": {
        "tempo": 72,
        "notes": [
         {
          "beat": 0,
          "length": 4,
          "step": 0,
          "lyric": "oo"
         }
        ],
        "turn": false,
        "drone": {
         "step": 0
        }
       }
      },
      {
       "kind": "play",
       "text": {
        "en": "Hold your note with the drone under it."
       },
       "exercise": {
        "tempo": 72,
        "notes": [
         {
          "beat": 0,
          "length": 6,
          "step": 0,
          "lyric": "oo"
         }
        ],
        "turn": false,
        "drone": {
         "step": 0
        }
       }
      }
     ]
    },
    {
     "id": "2-vowels",
     "title": {
      "en": "Vowels"
     },
     "steps": [
      {
       "kind": "learn",
       "text": {
        "en": "Keep the note the same while the vowel changes: \"oo\", \"oh\", \"ah\". Your mouth moves; the pitch stays."
       }
      },
      {
       "kind": "play",
       "text": {
        "en": "Listen, then sing the three vowels on one note."
       },
       "exercise": {
        "tempo": 72,
        "notes": [
         {
          "beat": 0,
          "length": 2,
          "step": 0,
          "lyric": "oo"
         },
         {
          "beat": 2,
          "length": 2,
          "step": 0,
          "lyric": "oh"
         },
         {
          "beat": 4,
          "length": 2,
          "step": 0,
          "lyric": "ah"
         }
        ],
        "turn": true
       }
      }
     ]
    },
    {
     "id": "2-challenge",
     "title": {
      "en": "Eight beats with the drone"
     },
     "steps": [
      {
       "kind": "play",
       "text": {
        "en": "The unit's challenge: hold your note for eight beats against the drone."
       },
       "exercise": {
        "tempo": 72,
        "notes": [
         {
          "beat": 0,
          "length": 8,
          "step": 0,
          "lyric": "oo"
         }
        ],
        "turn": false,
        "drone": {
         "step": 0
        }
       }
      }
     ],
     "challenge": true
    }
   ]
  },
  {
   "id": "moving-notes",
   "title": {
    "en": "Moving notes"
   },
   "colour": 3,
   "lessons": [
    {
     "id": "3-steps-up",
     "title": {
      "en": "Steps up"
     },
     "steps": [
      {
       "kind": "learn",
       "text": {
        "en": "Most tunes move by step, to the next note up or down. Here's do, re, mi."
       }
      },
      {
       "kind": "play",
       "text": {
        "en": "Listen, then sing the steps up."
       },
       "exercise": {
        "tempo": 72,
        "notes": [
         {
          "beat": 0,
          "length": 1,
          "step": 0,
          "lyric": "do"
         },
         {
          "beat": 1,
          "length": 1,
          "step": 2,
          "lyric": "re"
         },
         {
          "beat": 2,
          "length": 2,
          "step": 4,
          "lyric": "mi"
         }
        ],
        "turn": true
       }
      }
     ]
    },
    {
     "id": "3-steps-down",
     "title": {
      "en": "Steps down"
     },
     "steps": [
