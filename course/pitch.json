    "units": [
        {
            "id": "pp-land-it",
            "title": {
                "en": "Land it"
            },
            "colour": 2,
            "lessons": [
                {
                    "id": "pp-1-bullseye",
                    "title": {
                        "en": "Bullseye"
                    },
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": {
                                "en": "Land right on a note, don't slide into it. That's what makes a harmony ring."
                            },
                            "steps": [
                                {
                                    "title": {
                                        "en": "Listen"
                                    },
                                    "detail": {
                                        "en": "The guide sings a note"
                                    }
                                },
                                {
                                    "title": {
                                        "en": "Think it, then breathe"
                                    },
                                    "detail": {
                                        "en": "Hear it in your head first"
                                    }
                                },
                                {
                                    "title": {
                                        "en": "Land on \"dah\""
                                    },
                                    "detail": {
                                        "en": "Medium volume, easy and relaxed"
                                    }
                                }
                            ],
                            "listen": {
                                "tempo": 72,
                                "notes": [
                                    {
                                        "beat": 1.0,
                                        "length": 1.5,
                                        "step": 0,
                                        "lyric": "dah"
                                    },
                                    {
                                        "beat": 3.0,
                                        "length": 1.5,
                                        "step": 0,
                                        "lyric": "dah"
                                    },
                                    {
                                        "beat": 5.5,
                                        "length": 1.5,
                                        "step": 4,
                                        "lyric": "dah"
                                    },
                                    {
                                        "beat": 7.5,
                                        "length": 1.5,
                                        "step": 4,
                                        "lyric": "dah"
                                    }
                                ],
                                "turn": false
                            },
                            "visual": "echo",
                            "reviewed": false
                        },
                        {
                            "kind": "bullseye",
                            "text": {
                                "en": "Two to warm up. Sing each note back after the guide, and watch where it lands."
                            },
                            "exercise": {
                                "tempo": 72,
                                "echoes": [
                                    0,
                                    2
                                ],
                                "generous": true
                            }
                        },
                        {
                            "kind": "bullseye",
                            "text": {
                                "en": "Round 1: five notes. Listen, think it, then land on it."
                            },
                            "exercise": {
                                "tempo": 72,
                                "echoes": [
                                    0,
                                    4,
                                    2,
                                    -3,
                                    5
                                ],
                                "generous": true
                            }
                        },
                        {
                            "kind": "bullseye",
                            "text": {
                                "en": "Round 2: five more. Closer to the middle this time?"
                            },
                            "exercise": {
                                "tempo": 72,
                                "echoes": [
                                    2,
                                    -2,
                                    5,
                                    0,
                                    3
                                ],
                                "generous": true
                            },
                            "measures": {
                                "en": "Your stars are for where your second round's notes landed: close to the middle, and without sliding in."
                            }
                        }
                    ]
                },
                {
                    "id": "pp-1-scoop",
                    "title": {
                        "en": "Scoop or clean"
                    },
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": {
                                "en": "A scoop is sliding up into a note from below. It's a habit, and habits change."
                            },
                            "steps": [
                                {
                                    "title": {
                                        "en": "Scooped"
                                    },
                                    "detail": {
                                        "en": "Starts low, slides up to the note"
                                    }
                                },
                                {
                                    "title": {
                                        "en": "Clean"
                                    },
                                    "detail": {
                                        "en": "Starts right on the note"
                                    }
                                },
                                {
                                    "title": {
                                        "en": "The trick"
                                    },
                                    "detail": {
                                        "en": "Think the note before you breathe in"
                                    }
                                }
                            ],
                            "listen": {
                                "tempo": 72,
                                "notes": [
                                    {
                                        "beat": 1.0,
                                        "length": 1.5,
                                        "step": 0,
                                        "lyric": "dah"
                                    },
                                    {
                                        "beat": 3.0,
                                        "length": 1.5,
                                        "step": 0,
                                        "lyric": "dah"
                                    },
                                    {
                                        "beat": 5.5,
                                        "length": 1.5,
                                        "step": 4,
                                        "lyric": "dah"
                                    },
                                    {
                                        "beat": 7.5,
                                        "length": 1.5,
                                        "step": 4,
                                        "lyric": "dah"
                                    }
                                ],
                                "turn": false
                            },
                            "visual": "steady",
                            "reviewed": false
                        },
                        {
                            "kind": "bullseye",
                            "text": {
                                "en": "Slide up into the first two on purpose, then start the next two right on the note. Watch the trails."
                            },
                            "exercise": {
                                "tempo": 72,
                                "echoes": [
                                    0,
                                    0,
                                    4,
                                    4
                                ]
                            }
                        },
                        {
                            "kind": "bullseye",
                            "text": {
                                "en": "Four notes, each one clean. Listen, think it, then land on it."
                            },
                            "exercise": {
                                "tempo": 72,
                                "echoes": [
                                    0,
                                    3,
                                    -2,
                                    5
                                ]
                            },
                            "measures": {
                                "en": "Your stars are for where your notes landed: close to the middle, and without sliding in. A note that slid in counts half."
                            }
                        }
                    ]
                },
                {
                    "id": "pp-1-leaps",
                    "title": {
                        "en": "Think it, then leap"
                    },
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": {
                                "en": "Do is your note. Re, mi, fa and so are the steps up from it: 2, 3, 4 and 5."
                            },
                            "steps": [
                                {
                                    "title": {
                                        "en": "Do (1)"
                                    },
                                    "detail": {
                                        "en": "Your comfortable note, home"
                                    }
                                },
                                {
                                    "title": {
                                        "en": "Mi (3) and so (5)"
                                    },
                                    "detail": {
                                        "en": "A jump of three and of five up"
                                    }
                                },
                                {
                                    "title": {
                                        "en": "La (below)"
                                    },
                                    "detail": {
                                        "en": "Three steps under do"
                                    }
                                }
                            ],
                            "listen": {
                                "tempo": 72,
                                "notes": [
                                    {
                                        "beat": 1.0,
                                        "length": 1,
                                        "step": 0,
                                        "lyric": "dah"
                                    },
                                    {
                                        "beat": 2.0,
                                        "length": 1.5,
                                        "step": 7,
                                        "lyric": "dah"
                                    },
                                    {
                                        "beat": 5.5,
                                        "length": 1,
                                        "step": 0,
                                        "lyric": "dah"
                                    },
                                    {
                                        "beat": 6.5,
                                        "length": 1.5,
                                        "step": 7,
                                        "lyric": "dah"
                                    }
                                ],
                                "turn": false
                            },
                            "visual": "ladder",
                            "reviewed": false
                        },
                        {
                            "kind": "bullseye",
                            "text": {
                                "en": "Hear the pair, then two quiet beats: hear it in your head. Then sing it. Did you hear it before you sang?"
                            },
                            "exercise": {
                                "tempo": 72,
                                "echoes": [
                                    [
                                        0,
                                        7
                                    ],
                                    [
                                        0,
                                        4
                                    ]
                                ],
                                "think": 2
                            }
                        },
                        {
                            "kind": "bullseye",
                            "text": {
                                "en": "Do to so, so to do, do to mi, la (below) to do. Each note short and separate."
                            },
                            "exercise": {
                                "tempo": 72,
                                "echoes": [
                                    [
                                        0,
                                        7
                                    ],
                                    [
                                        7,
                                        0
                                    ],
                                    [
                                        0,
                                        4
                                    ],
                                    [
                                        -3,
                                        0
                                    ]
                                ],
                                "think": 2
                            },
                            "measures": {
                                "en": "Your stars are for landing each note of the leaps, close to the middle, without sliding in."
                            }
                        }
                    ]
                },
                {
