                        "en": "Cool down",
                        "es": "Enfriamiento",
                        "de": "Abwärmen"
                    },
                    "minutes": 2,
                    "unscored": true,
                    "steps": [
                        {
                            "kind": "learn",
                            "headline": {
                                "en": "Two easy minutes to bring your voice back down to speaking. Nothing here is scored.",
                                "es": "Dos minutos tranquilos para volver, poco a poco, a tu voz hablada. Aquí nada se puntúa.",
                                "de": "Zwei ruhige Minuten, in denen deine Stimme zur Sprechstimme zurückfindet. Hier wird nichts bewertet."
                            },
                            "steps": [
                                {
                                    "title": {
                                        "en": "Quieter than you sang",
                                        "es": "Más suave que al cantar",
                                        "de": "Leiser als beim Singen"
                                    },
                                    "detail": {
                                        "en": "Easy, never pushed",
                                        "es": "Sin esfuerzo, sin forzar",
                                        "de": "Locker, nie gedrückt"
                                    }
                                },
                                {
                                    "title": {
                                        "en": "Every slide goes down",
                                        "es": "Siempre hacia abajo",
                                        "de": "Immer abwärts gleiten"
                                    },
                                    "detail": {
                                        "en": "From a little above your note to below it",
                                        "es": "Desde un poco por encima de tu nota hasta por debajo",
                                        "de": "Von knapp über deinem Ton bis darunter"
                                    }
                                },
                                {
                                    "title": {
                                        "en": "Stop if anything hurts",
                                        "es": "Para si algo duele",
                                        "de": "Wenn etwas wehtut, hör auf"
                                    },
                                    "detail": {
                                        "en": "Tightness, a tickle or pain: rest instead",
                                        "es": "Tensión, carraspera o dolor: descansa la voz",
                                        "de": "Enge, Kratzen oder Schmerz: Gönn deiner Stimme eine Pause"
                                    }
                                }
                            ],
                            "reviewed": false
                        },
                        {
                            "kind": "wave",
                            "text": {
                                "en": "Slide down on a quiet \"oo\", like a sigh, three times. Follow the ribbon, or just let it fall.",
                                "es": "Desliza la voz hacia abajo en un \"oo\" (una u) suave, como un suspiro, tres veces. Sigue la línea que baja o, simplemente, deja caer la voz.",
                                "de": "Gleite dreimal auf einem leisen \"oo\" (ein langes u wie in \"Schuh\") nach unten, wie bei einem Seufzer. Folge der Linie oder lass die Stimme einfach fallen."
                            },
                            "exercise": {
                                "tempo": 60,
                                "lead": 2,
                                "step": 0,
                                "lyric": "oo",
                                "combo": false,
                                "target": [
                                    {
                                        "seconds": 3,
